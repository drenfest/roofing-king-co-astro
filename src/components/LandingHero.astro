---
import HomeImage from './HomeImage.astro';
import site from '../data/site.json';
import RichContent from './RichContent.astro';
import type {RichNode} from '../data/section-types';
interface Props {hero:{eyebrow:string;title:string;description:string;body?:RichNode[];image:{src:string;alt:string};caption:string;action:string;nextHref?:string;nextLabel?:string};serviceName?:string;}
const {hero,serviceName}=Astro.props;
const nextLabel=serviceName?`Read More About ${serviceName}`:hero.nextLabel||`Read More About ${hero.title}`;
---
<section class="rk-landing-hero" data-component="LandingHero">
  <div class="rk-section-inner rk-landing-hero-grid">
    <div class="rk-landing-hero-copy"><p class="rk-home-eyebrow">{hero.eyebrow}</p><h1>{hero.title}</h1>{hero.body?<div class="rk-landing-lede"><RichContent nodes={hero.body}/></div>:<p class="rk-landing-lede">{hero.description}</p>}
      <div class="rk-landing-actions"><a class="rk-button rk-button-primary" href="#estimate">{hero.action} <span aria-hidden="true">↗</span></a><a href={site.phoneHref}>Talk with our team <strong>{site.phone}</strong></a></div>
      <a class="rk-landing-text-link" href={hero.nextHref || '#roofing-services'}>{nextLabel} <span aria-hidden="true">↓</span></a>
    </div>
    <figure class="rk-landing-hero-photo"><HomeImage {...hero.image} sizes="(max-width:760px) 100vw, 50vw" eager/><figcaption><span aria-hidden="true">01 /</span> {hero.caption}</figcaption></figure>
  </div>
</section>
