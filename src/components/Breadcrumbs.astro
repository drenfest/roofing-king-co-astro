---
interface Props { items: {label:string;href?:string}[]; }
const { items } = Astro.props;
---
<nav class="rk-native-breadcrumbs rk-section-inner" aria-label="Breadcrumb"><ol>{items.map((item,i)=><li>{item.href && i < items.length - 1 ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>)}</ol></nav>
