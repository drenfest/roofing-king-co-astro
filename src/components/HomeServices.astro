---
import { services } from '../data/home.json';
import site from '../data/site.json';
import HomeImage from './HomeImage.astro';
import SectionHeading from './SectionHeading.astro';
---
<section id="services" class="rk-home-section rk-home-services">
  <div class="rk-section-inner"><SectionHeading {...services} />
    <div class="rk-home-services-grid">
      {services.items.map((service, i) => <a class={`rk-home-service-card rk-service-card-${i + 1}`} href={service.href}>
        <h3>{service.title}</h3>
        {service.image && <HomeImage {...service.image} class="rk-home-service-image" sizes="(max-width: 760px) calc(100vw - 5rem), (max-width: 1060px) 43vw, 350px"/>}
        <p>{service.description}</p><strong>Learn more</strong>
      </a>)}
      <aside class="rk-home-service-visual rk-home-service-cta" aria-label="Request an exterior services quote">
        <a class="rk-button rk-button-primary" href="#quote-form" data-quote-open>Get a free quote</a>
        <a class="rk-home-service-phone" href={site.phoneHref}>{site.phone}</a>
      </aside>
    </div>
  </div>
</section>

<style>
.rk-home-services-grid .rk-home-service-card{display:flex;flex-direction:column;}
.rk-home-service-card :global(.rk-home-service-image){display:block;width:100%;height:auto;aspect-ratio:1.9;object-fit:cover;margin:.3rem 0 1rem;border-radius:3px;transition:filter var(--rk-motion-fast);}
.rk-home-service-card:hover :global(.rk-home-service-image){filter:brightness(1.04);}
.rk-home-service-card>strong{align-self:flex-start;margin-top:auto;}
</style>
