---
import ServiceIcon from './ServiceIcon.astro';
import ServiceExplorer from './ServiceExplorer.svelte';
interface Props {section:{eyebrow:string;title:string;description:string;items:{id:string;tabLabel:string;title:string;description:string;detail:string;highlights:string[];href:string;label:string;icon:string}[]};}
const {section}=Astro.props;
---
<section id="roofing-services" class="rk-landing-section rk-service-paths" data-component="ServicePaths" aria-labelledby="roofing-services-title"><div class="rk-section-inner">
  <div class="rk-landing-heading"><p class="rk-home-eyebrow">{section.eyebrow}</p><h2 id="roofing-services-title">{section.title}</h2><p>{section.description}</p></div>
  <ServiceExplorer id="roofing-services" label="Choose a roofing topic" tabs={section.items.map(item=>({id:item.id,label:item.tabLabel}))} client:load>
    {section.items.map((item,i)=><article id={item.id} class="rk-service-detail" data-service-panel aria-labelledby={`${item.id}-heading`}>
      <div class="rk-service-detail-kicker"><ServiceIcon name={item.icon as 'repair'|'roof'|'storm'|'shield'|'cost'|'calculator'}/><span>0{i+1} / {item.tabLabel}</span></div><h3 id={`${item.id}-heading`}>{item.title}</h3><p>{item.description}</p><p>{item.detail}</p><ul>{item.highlights.map(text=><li><ServiceIcon name="check"/>{text}</li>)}</ul><a class="rk-button rk-button-secondary" href={item.href}>{item.label}<ServiceIcon name="arrow"/></a>
    </article>)}
  </ServiceExplorer>
  <p class="rk-landing-aside">Planning work for a business property? <a href="/commercial-roofing/">Explore commercial roofing.</a></p>
</div></section>
