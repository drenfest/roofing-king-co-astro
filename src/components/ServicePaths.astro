---
import ServiceIcon from './ServiceIcon.astro';
import ServiceExplorer from './ServiceExplorer.svelte';
import ServiceAudienceBanner from './ServiceAudienceBanner.astro';
import RichContent from './RichContent.astro';
import HomeImage from './HomeImage.astro';
import {serviceHero} from '../data/service-hero';
import {productHeroImage} from '../data/product-presentation';
import type {ServicePathsData} from '../data/section-types';
interface Props {section:ServicePathsData;}
const {section}=Astro.props;
const id=section.id || 'roofing-services';
---
<section id={id} class="rk-landing-section rk-service-paths" data-component="ServicePaths" aria-labelledby={`${id}-title`}><div class="rk-section-inner">
  <div class="rk-landing-heading"><p class="rk-home-eyebrow">{section.eyebrow}</p><h2 id={`${id}-title`}>{section.title}</h2>{section.intro?.length?<RichContent nodes={section.intro}/>:<p>{section.description}</p>}</div>
  <ServiceExplorer {id} scrollable={section.scrollableTabs} label={section.selectorLabel || 'Choose a roofing topic'} tabs={section.items.map(item=>({id:item.id,label:item.tabLabel}))} client:load>
    {section.items.map(item=>{const hero=item.image?{image:item.image,generated:false}:serviceHero(item.href);return <article id={item.id} class="rk-service-detail" data-service-panel aria-labelledby={`${item.id}-heading`}>
      <div class="rk-service-detail-kicker"><ServiceIcon name={item.icon as 'repair'|'roof'|'storm'|'shield'|'cost'|'calculator'}/><span>{item.tabLabel}</span></div>
      <figure class="rk-service-tab-image" data-child-hero={item.image?undefined:item.href} data-topic-photo={item.image?item.id:undefined}><HomeImage {...hero.image} sizes="(max-width:760px) 90vw, (max-width:1100px) 60vw, 740px"/>{item.caption?<figcaption>{item.caption}</figcaption>:null}</figure>
      <h3 id={`${item.id}-heading`}>{item.title}</h3>{item.body?<RichContent nodes={item.body}/>:<><p>{item.description}</p>{item.detail && <p>{item.detail}</p>}</>}{item.groups?.map(group=><section class="rk-service-topic-group"><h4>{group.title}</h4>{group.description&&<p>{group.description}</p>}{group.table&&<div class="rk-service-topic-table" tabindex="0" role="region" aria-label={group.table.caption}><table><caption>{group.table.caption}</caption><thead><tr><th scope="col">Compare</th>{group.table.columns.map(column=><th scope="col">{column}</th>)}</tr></thead><tbody>{group.table.rows.map(row=><tr><th scope="row">{row.label}</th>{row.values.map(value=><td>{value}</td>)}</tr>)}</tbody></table></div>}{group.cards&&<div class="rk-service-topic-cards">{group.cards.map(card=><article>{card.href?.startsWith('/products/')&&<HomeImage {...productHeroImage(card.href)} sizes="(max-width:760px) 85vw, 340px"/>}<h5>{card.title}</h5><p>{card.description}</p>{card.summary&&<details><summary>{card.summary}</summary>{card.body&&<RichContent nodes={card.body}/>}</details>}{card.href&&<a href={card.href} title={card.label||card.title}>{card.label||'Explore products'} <span aria-hidden="true">→</span></a>}</article>)}</div>}{group.after&&<RichContent nodes={group.after}/>}</section>)}{item.highlights.length>0 && <ul>{item.highlights.map(text=><li><ServiceIcon name="check"/>{text}</li>)}</ul>}<a class="rk-button rk-button-secondary" href={item.href}>{item.label}<ServiceIcon name="arrow"/></a>{item.related && item.related.length>0 && <nav class="rk-service-related-links" aria-label={`More ${item.tabLabel.toLowerCase()} information`}>{item.related.map(link=><a href={link.href}><span>{link.label}</span><ServiceIcon name="arrow"/></a>)}</nav>}
    </article>;})}
  </ServiceExplorer>
  {section.banner && <ServiceAudienceBanner banner={section.banner}/>}
</div></section>

<style>
.rk-service-topic-group{margin-top:2rem;padding-top:1.5rem;border-top:1px solid #d9d1c4;}.rk-service-topic-group h4{margin:0 0 1rem;}.rk-service-topic-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;}.rk-service-topic-cards article{min-width:0;padding:1.1rem;background:#f7f2e8;border-top:2px solid #c65005;}.rk-service-topic-cards :global(img){display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover;margin-bottom:1rem;}.rk-service-topic-cards h5{margin:.3rem 0 .75rem;color:#242321;}.rk-service-topic-cards p{font-size:.9rem;line-height:1.75;}.rk-service-topic-cards summary{font-size:.85rem;font-weight:600;cursor:pointer;padding:.7rem 0;color:#a44305;}.rk-service-topic-cards details :global(p),.rk-service-topic-cards details :global(li){font-size:.87rem;line-height:1.75;}.rk-service-topic-cards a{display:inline-flex;align-items:center;gap:.6rem;min-height:44px;color:#a44305;font-weight:600;font-size:.85rem;}.rk-service-topic-table{max-width:100%;overflow-x:auto;margin:1rem 0;}.rk-service-topic-table table{width:100%;min-width:580px;border-collapse:collapse;font-size:.85rem;line-height:1.65;}.rk-service-topic-table th,.rk-service-topic-table td{padding:.8rem;text-align:left;vertical-align:top;border:1px solid #d9d1c4;}.rk-service-topic-table thead th{background:#242321;color:#fff;}.rk-service-topic-table tbody th{background:#f0e7d7;}.rk-service-topic-table caption{text-align:left;font-weight:600;margin-bottom:.75rem;}@media(max-width:760px){.rk-service-topic-cards{grid-template-columns:minmax(0,1fr);}}
</style>
