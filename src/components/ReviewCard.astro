---
import type { CardSectionData } from '../data/section-types';
import platforms from '../data/review-platforms.json';
interface Props { card: CardSectionData['items'][number] & {publishedOn?:string}; }
const {card}=Astro.props;
const platformLogo=(platform:string)=>platforms[platform as keyof typeof platforms];
---
<article class="rk-home-review-card">
        {card.rating ? <div class="rk-stars" aria-label={`${card.rating} out of 5 stars`}>{'★'.repeat(card.rating)}{'☆'.repeat(5-card.rating)}</div> : <div class="rk-stars rk-review-platform">{card.source?.platform || 'Customer'} review</div>}
        <h3>{card.title}</h3><p>{card.excerpt ? `“${card.description}”` : card.description}</p>
        {(card.author || card.source) && <footer class="rk-review-attribution">
          {card.author && <span class="rk-review-author">{card.author}{card.excerpt && <small>Review excerpt</small>}{card.publishedOn && <small><time datetime={card.publishedOn}>{new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'}).format(new Date(card.publishedOn+'T00:00:00Z'))}</time></small>}</span>}
          {card.source && <a class="rk-review-source" href={card.source.url} target="_blank" rel="noopener noreferrer" aria-label={`Read ${card.author ? `${card.author}’s` : 'this'} review on ${card.source.platform} (opens in a new tab)`}>
            <span>Read on</span>
            {platformLogo(card.source.platform) && <img class:list={['rk-review-source-logo',{'rk-review-source-wordmark':platformLogo(card.source.platform).wordmark}]} src={platformLogo(card.source.platform).src} width={platformLogo(card.source.platform).width} height={platformLogo(card.source.platform).height} alt={platformLogo(card.source.platform).wordmark?card.source.platform:''} loading="lazy"/>}
            {!platformLogo(card.source.platform)?.wordmark && <strong>{card.source.platform}</strong>}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M14 3h7v7M21 3l-10 10M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5" /></svg>
          </a>}
        </footer>}
      </article>
