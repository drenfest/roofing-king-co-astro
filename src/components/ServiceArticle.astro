---
import type {ServicePathsData} from '../data/section-types';
interface Props {section:ServicePathsData;}
const {section}=Astro.props;
const id=section.id || 'service-topics';
---
<section id={id} class="rk-landing-section rk-service-article" data-component="ServiceArticle" aria-labelledby={`${id}-title`}>
  <div class="rk-section-inner">
    <div class="rk-landing-heading"><p class="rk-home-eyebrow">{section.eyebrow}</p><h2 id={`${id}-title`}>{section.title}</h2><p>{section.description}</p></div>
    <div class="rk-service-article-rows">{section.items.map(item=><article id={item.id} class="rk-service-article-row" aria-labelledby={`${item.id}-heading`}>
      <h3 id={`${item.id}-heading`}>{item.title}</h3>
      <div><p>{item.description}</p>{item.detail&&<p>{item.detail}</p>}{item.highlights.length>0&&<ul>{item.highlights.map(text=><li>{text}</li>)}</ul>}<a href={item.href}>{item.label} <span aria-hidden="true">→</span></a>{item.related?.length&&<div class="rk-service-related-links">{item.related.map(link=><a href={link.href}>{link.label} ↗</a>)}</div>}</div>
    </article>)}</div>
  </div>
</section>
