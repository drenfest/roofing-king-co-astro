---
import type { RichNode } from '../data/section-types';
interface Props { nodes: RichNode[]; }
const { nodes } = Astro.props;
---
{nodes.map(node => node.tag ? <node.tag id={node.id} data-internal-link-id={node.instructionId} class={node.role==='eyebrow'?'rk-home-eyebrow':undefined} href={node.tag === 'a' ? node.href : undefined}><Astro.self nodes={node.children} /></node.tag> : node.text)}
