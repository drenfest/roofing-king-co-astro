---
import type { HeadingData, RichNode } from '../data/section-types';
import SectionHeading from './SectionHeading.astro';
import RichContent from './RichContent.astro';
interface Props { section: HeadingData & {items:{question:string;answer:RichNode[]}[]}; }
const { section } = Astro.props;
---
<section class="rk-home-section rk-service-faq" data-component="FAQSection"><div class="rk-section-inner"><SectionHeading {...section}/><div class="rk-service-faq-list">{section.items.map(item=><details><summary>{item.question}</summary><div><RichContent nodes={item.answer}/></div></details>)}</div></div></section>
