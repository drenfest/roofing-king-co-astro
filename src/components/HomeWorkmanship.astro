---
import { promo, process, coverage } from '../data/home.json';
import HomeImage from './HomeImage.astro';
import SectionHeading from './SectionHeading.astro';
---
<section class="rk-home-promo">
  <div class="rk-section-inner rk-home-promo-card">
    <div><p class="rk-home-eyebrow">{promo.eyebrow}</p><h2>{promo.title}</h2><p>{promo.description}</p>
      <div class="rk-home-action-row"><a class="rk-button rk-button-primary" href="#quote-form" data-quote-open>Get a Free Quote</a><a class="rk-button rk-button-outline" href="/about-us/">Learn More</a></div>
    </div>
    <HomeImage {...promo.image} />
  </div>
</section>
<section class="rk-home-section rk-home-process"><div class="rk-section-inner">
  <SectionHeading {...process} /><div class="rk-home-process-row">{process.items.map((item, i) => <article><span>{String(i + 1).padStart(2, '0')}</span><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
</div></section>
<section class="rk-home-section rk-home-areas rk-coverage-map-block"><div class="rk-section-inner rk-coverage-map-inner">
  <div class="rk-coverage-map-copy"><p class="rk-home-eyebrow">{coverage.eyebrow}</p><h2>{coverage.title}</h2><p>{coverage.description}</p>
    <div class="rk-home-action-row"><a class="rk-button rk-button-primary" href="#quote-form" data-quote-open>Get A Free Quote</a><a class="rk-button rk-button-outline" href="/service-areas/">View Service Areas</a></div>
  </div>
  <a class="rk-home-map rk-coverage-map-media" href="/past-projects/"><HomeImage {...coverage.image} /></a>
</div></section>
