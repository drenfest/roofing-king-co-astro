---
import { offers, blogs, reviews } from '../data/home.json';
import CardSection from './CardSection.astro';
import ReviewSection from './ReviewSection.astro';
interface Props { kind: 'offers' | 'blogs' | 'reviews'; }
const { kind } = Astro.props;
---
{kind==='reviews'?<ReviewSection section={reviews}/>:<CardSection {kind} section={{offers, blogs}[kind]} />}
