---
import type {MediaContentRowData} from '../data/section-types';
interface Props {links:MediaContentRowData['links'];tiles?:boolean;}
const {links,tiles=false}=Astro.props;
---
<div class:list={['rk-media-row-links',{'rk-resource-tiles':tiles}]}>
  {links.map(link=><a href={link.href} data-icon={link.icon}>
    {tiles && <span class="rk-resource-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      {link.icon==='roof'?<><path d="m3 11 9-8 9 8M5 10v10h14V10"/><path d="M9 20v-6h6v6"/></>:
       link.icon==='shingles'?<><path d="M5 3h14l3 6H2l3-6ZM3 10l-1 5h20l-1-5M3 16l-1 5h20l-1-5M9 3v6m6 0v6m-6 0v6"/></>:
       link.icon==='brand'?<><path d="m12 3 8 3v6c0 4-4 7-8 9-4-2-8-5-8-9V6l8-3Z"/><path d="m8 12 3 3 5-6"/></>:
       <><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></>}
    </svg></span>}
    <span class="rk-resource-label">{link.label}</span><span class="rk-resource-arrow" aria-hidden="true">→</span>
  </a>)}
</div>
