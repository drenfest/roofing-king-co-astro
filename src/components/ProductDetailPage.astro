---
import type { CollectionEntry } from 'astro:content';
import type { ProductDetailData } from '../data/product-types';
import {productLibrary} from '../data/product-library';
import site from '../data/site.json';
import ProductLayout from '../layouts/ProductLayout.astro';
import ProductCard from './ProductCard.astro';
import ProductCompanions from './ProductCompanions.astro';
import ProductTabs from './ProductTabs.svelte';
import ProductWarranty from './ProductWarranty.astro';
import ProductSpecifications from './ProductSpecifications.astro';
import ProductComparisonSection from './ProductComparisonSection.astro';
import {productCompanions} from '../data/product-system-companions';
interface Props {page:CollectionEntry<'pages'>;data:ProductDetailData;}
const {page,data}=Astro.props;
const product=productLibrary[data.key];
const parent= data.parentProductId?productLibrary[data.parentProductId]:undefined;
const parentCrumb=parent?data.breadcrumbs.at(-2):undefined;
const hasCompanions=!!productCompanions(product.id);
const tabs=[{id:'warranty',label:'Warranty & protection'},{id:'specifications',label:'Product specifications'},...(hasCompanions?[{id:'roof-system',label:'Companion products'}]:[])];
const color=product.colors.find(c=>c.id===product.defaultColorId)!;
const schema={'@context':'https://schema.org','@type':'Product',name:data.title,description:data.description,brand:{'@type':'Brand',name:product.brand||'GAF'},image:new URL(color.image.src,site.url).href,url:new URL(page.data.permalink,site.url).href};
---
<ProductLayout {page} heading={product.brand?data.title:`${data.title} Roofing Shingles`} eyebrow={`${product.brand||'GAF'} product details`} copy={data.description} breadcrumbs={data.breadcrumbs} image={color.image.src} productKey={data.key}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\u003c')}/>
  <section id="product-overview" class="rk-section-inner rk-product-detail-section" aria-label={`${data.title} colors and details`}><>{parent&&parentCrumb&&<p class="rk-product-guidance-reference" data-product-parent={parent.id}>Companion product for <a href={parent.detailPath} title={'Explore '+parentCrumb.label}>{parentCrumb.label} <span aria-hidden="true">→</span></a></p>}<ProductCard item={{title:data.title,body:data.body}} {product} detail/></></section>
  <section class="rk-product-information" aria-label="Product information and companion products">
    <div class="rk-section-inner"><header class="rk-product-section-heading"><p class="rk-home-eyebrow">Product information</p><h2>{data.title}: product and system details</h2></header><ProductTabs {tabs} client:load>
      <section id="warranty" data-product-panel class="rk-product-tab-panel rk-product-details"><h3>Warranty &amp; protection</h3><ProductWarranty {product}/></section>
      <section id="specifications" data-product-panel class="rk-product-tab-panel rk-product-details"><h3>Product specifications</h3><ProductSpecifications {product}/></section>
      {hasCompanions && <section id="roof-system" data-product-panel class="rk-product-tab-panel"><ProductCompanions productId={product.id}/></section>}
    </ProductTabs></div>
  </section>
  <ProductComparisonSection productId={product.id}/>
</ProductLayout>
