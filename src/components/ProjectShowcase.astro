---
import HomeImage from './HomeImage.astro';
interface Props {section:{eyebrow:string;title:string;description:string;images:{src:string;alt:string;caption:string;label?:string}[];href?:string;label?:string};}
const {section}=Astro.props;
---
<section id="roofing-work" class="rk-landing-section rk-project-showcase" data-component="ProjectShowcase" aria-labelledby="roofing-work-title"><div class="rk-section-inner"><div class="rk-landing-section-top"><div class="rk-landing-heading"><p class="rk-home-eyebrow">{section.eyebrow}</p><h2 id="roofing-work-title">{section.title}</h2><p>{section.description}</p></div><a class="rk-button rk-button-outline" href={section.href || "/past-projects/"}>{section.label || "Explore roofing projects"} <span aria-hidden="true">↗</span></a></div><div class="rk-project-showcase-grid">{section.images.map(image=><figure><div class="rk-project-showcase-photo"><HomeImage {...image} sizes="(max-width:760px) 100vw, 50vw"/>{image.label&&<span>{image.label}</span>}</div><figcaption>{image.caption}</figcaption></figure>)}</div></div></section>
