---
import ProductOptions from './ProductOptions.svelte';
import RichContent from './RichContent.astro';
import ProductWarranty from './ProductWarranty.astro';
import ProductSpecifications from './ProductSpecifications.astro';
import type { ProductPresentation } from '../data/product-types';
import type { RichNode } from '../data/section-types';
interface Props { item:{title:string;body:RichNode[]};product:ProductPresentation;detail?:boolean; }
const { item, product, detail=false } = Astro.props;
const Heading = detail ? 'h2' : 'h3';
---
<article class:list={["rk-product-card",{"rk-product-card-detail":detail}]} data-product={product.id} aria-labelledby={`product-${product.id}`}>
      <div class="rk-product-card-heading"><p class="rk-home-eyebrow">GAF shingles</p><Heading class="rk-product-card-title" id={`product-${product.id}`}>{item.title}</Heading></div>
      <div class="rk-product-visual">{detail ? <ProductOptions {product} title={item.title} client:load/> : <ProductOptions {product} title={item.title} client:visible/>}</div>
      <div class="rk-product-card-copy"><RichContent nodes={item.body}/></div>
      {!detail && <div class="rk-product-details">
        <details><summary>Warranty &amp; protection</summary><div><ProductWarranty {product}/></div></details>
        <details id={'specs-'+product.id}><summary>Product specifications</summary><div><ProductSpecifications {product}/></div></details>
      </div>}
      <a class="rk-product-source" href={product.sourceUrl} target="_blank" rel="noopener noreferrer">View {item.title} at GAF ↗</a>
    {!detail && <a class="rk-product-detail-link" href={'/products/roofing/shingles/gaf/'+product.id+'/'}>Explore {item.title} →</a>}
</article>
