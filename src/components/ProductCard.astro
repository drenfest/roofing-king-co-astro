---
import ProductOptions from './ProductOptions.svelte';
import RichContent from './RichContent.astro';
import ProductWarranty from './ProductWarranty.astro';
import ProductSpecifications from './ProductSpecifications.astro';
import type { ProductPresentation } from '../data/product-types';
import type { RichNode } from '../data/section-types';
interface Props { item:{title:string;body:RichNode[]};product:ProductPresentation;detail?:boolean; }
const { item, product, detail=false } = Astro.props;
const Heading = detail ? 'h2' : 'h3';
---
<article class:list={["rk-product-card",{"rk-product-card-detail":detail}]} data-product={product.id} data-product-brand={product.brand||'GAF'} data-product-image={product.colorPreview?.mode==='mask'?product.hero?.src:undefined} aria-labelledby={`product-${product.id}`}>
      <div class="rk-product-card-heading"><p class="rk-home-eyebrow">{product.categoryLabel||'GAF shingles'}</p><Heading class="rk-product-card-title" id={`product-${product.id}`}>{item.title}</Heading></div>
      <div class="rk-product-visual">{detail ? <ProductOptions {product} title={item.title} detail client:load/> : <ProductOptions {product} title={item.title} client:visible/>}</div>
      <div class="rk-product-card-copy"><RichContent nodes={item.body}/></div>
      {product.colorPreview && <noscript><p class="rk-product-reference-note">Enable JavaScript to preview siding colors on the sample home. The swatches link to manufacturer color information.</p></noscript>}
      {!detail && <div class="rk-product-details">
        <details><summary>Warranty &amp; protection</summary><div><ProductWarranty {product}/></div></details>
        <details id={'specs-'+product.id}><summary>Product specifications</summary><div><ProductSpecifications {product}/></div></details>
      </div>}
      {product.colorPreview?.mode==='mask'?<div class="rk-product-source"><a href={product.sourceUrl} target="_blank" rel="noopener noreferrer">View {item.title} at {product.brand} ↗</a><a class="rk-product-original-photo" href={product.hero?.src} target="_blank" rel="noopener noreferrer">View manufacturer product photograph ↗</a></div>:<a class="rk-product-source" href={product.sourceUrl} target="_blank" rel="noopener noreferrer">View {item.title} at {product.brand||'GAF'} ↗</a>}
    {detail && <div class="rk-product-booking"><a class="rk-button rk-button-secondary" href="#quote-form" title={`Discuss ${item.title} with Roof King`}>Discuss this product <span aria-hidden="true">→</span></a><p>We’ll help you review finishes and installation for your home.</p></div>}
    {!detail && <a class="rk-product-detail-link" href={product.detailPath||'/products/roofing/shingles/gaf/'+product.id+'/'}>Explore {item.title} →</a>}
</article>
