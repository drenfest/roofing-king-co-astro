---
import hubs from '../data/blog-hubs.json';
import routes from '../data/blog-routes.json';
import ServiceIcon from './ServiceIcon.astro';
interface Props {path?:string;}
const {path=Astro.url.pathname}=Astro.props;
const links=[{label:'All articles',href:'/blog/'},{label:'Categories',href:'/blog/categories/'},{label:'Topics',href:'/blog/topics/'}];
const article=routes.posts.find(post=>post.canonicalPath===path);
const categoryLinks=article?.categories.map(label=>{const group=hubs.categories.groups.find(g=>g.label===label);if(!group)throw Error('Missing category collection '+label);return {label,href:group.href};})||[];
const topicLinks=article?.tags.map(label=>{const group=hubs.topics.groups.find(g=>g.label===label);if(!group)throw Error('Missing topic collection '+label);return {label,href:group.href};})||[];
---
<aside class="rk-blog-resource-aside" aria-label="Blog navigation" data-component="BlogNavigation"><nav aria-label="Blog resources"><p class="rk-home-eyebrow">Explore the blog</p><ul class="rk-blog-resource-main">{links.map(link=><li><a href={link.href} title={`Browse ${link.label.toLowerCase()}`} aria-current={path===link.href?'page':undefined}>{link.label}<ServiceIcon name="arrow"/></a></li>)}</ul>{(categoryLinks.length>0||topicLinks.length>0)&&<section class="rk-article-taxonomy" aria-label="Categories and topics for this article" data-article-taxonomy><p class="rk-home-eyebrow">Article tags</p>{[{label:'Categories',items:categoryLinks},{label:'Topics',items:topicLinks}].filter(group=>group.items.length>0).map(group=><div><p class="rk-article-taxonomy-label">{group.label}</p><ul aria-label={`${group.label} for this article`}>{group.items.map(link=><li><a href={link.href} title={`Browse ${link.label} articles`}>{link.label}</a></li>)}</ul></div>)}</section>}{Object.entries(hubs).map(([kind,hub])=><details><summary>{kind==='categories'?'Service categories':'Locations and topics'}</summary><ul class="rk-blog-resource-collections">{hub.groups.map(group=><li><a href={group.href} title={`Read ${group.label} articles`} aria-current={path===group.href?'page':undefined}>{group.label}<span>{group.count}</span></a></li>)}</ul></details>)}</nav></aside>
<style>
 .rk-blog-resource-aside{align-self:start;position:sticky;top:8rem;max-height:calc(100svh - 9rem);overflow-y:auto;scrollbar-width:thin;overscroll-behavior:contain;background:#f2ede3;border-top:2px solid #fe6600;padding:1.3rem;min-width:0;}.rk-blog-resource-aside .rk-home-eyebrow{font-size:.68rem;margin-bottom:1rem;}.rk-blog-resource-aside ul{list-style:none;margin:0;padding:0;}.rk-blog-resource-aside a{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:46px;padding:.65rem 0;color:#34312d;text-decoration:none;font-size:.86rem;line-height:1.45;transition:color .18s ease;}.rk-blog-resource-aside a:hover,.rk-blog-resource-aside a[aria-current]{color:#a44305;}.rk-blog-resource-aside a[aria-current]{font-weight:650;}.rk-blog-resource-main li+li{border-top:1px solid #dcd3c5;}.rk-blog-resource-main svg{width:18px;height:18px;flex-shrink:0;color:#b54a05;}.rk-blog-resource-aside details{border-top:1px solid #d0c6b7;margin-top:1rem;padding-top:.7rem;}.rk-blog-resource-aside summary{min-height:44px;padding:.7rem 0;font-size:.82rem;font-weight:600;cursor:pointer;}.rk-blog-resource-collections{max-height:320px;overflow:auto;scrollbar-width:thin;}.rk-blog-resource-collections a{padding-right:.4rem;font-size:.8rem;}.rk-blog-resource-collections span{font-size:.72rem;color:#756d61;}.rk-blog-resource-aside :is(a,summary):focus-visible{outline:2px solid #b54a05;outline-offset:3px;}@media(max-width:900px){.rk-blog-resource-aside{position:static;max-height:none;overflow:visible;}}@media(prefers-reduced-motion:reduce){.rk-blog-resource-aside a{transition:none;}}
 .rk-article-taxonomy{border-top:1px solid #d0c6b7;margin-top:1rem;padding-top:1.3rem;}.rk-article-taxonomy>div+div{margin-top:1rem;}.rk-article-taxonomy-label{font-size:.74rem;font-weight:600;margin:0 0 .5rem;color:#62594e;}.rk-article-taxonomy ul{display:flex;flex-wrap:wrap;gap:.4rem;}.rk-article-taxonomy li{min-width:0;max-width:100%;}.rk-article-taxonomy a{display:inline-flex;min-height:44px;padding:.5rem .65rem;border:1px solid #d6cbb9;background:#fffdf8;font-size:.78rem;overflow-wrap:anywhere;transition:background .18s ease,border-color .18s ease;}.rk-article-taxonomy a:hover{background:#fff4e6;border-color:#c66a28;}@media(prefers-reduced-motion:reduce){.rk-article-taxonomy a{transition:none;}}
</style>
