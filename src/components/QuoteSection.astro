---
import QuoteExperience from './QuoteExperience.svelte';
import type { HeadingData } from '../data/section-types';
import contact from '../data/project-contact.json';
interface Props { quote:HeadingData; }
const { quote } = Astro.props;
---
<section class="rk-home-final-cta"><div class="rk-section-inner rk-quote-strip-inner"><div><p class="rk-home-eyebrow">{quote.eyebrow}</p><h2>{contact.title}</h2><p>{contact.description}</p></div><QuoteExperience inlineHeading={false} client:load/></div></section>
