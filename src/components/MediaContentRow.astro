---
import type {MediaContentRowData} from '../data/section-types';
import RichContent from './RichContent.astro';
import HomeImage from './HomeImage.astro';
interface Props {section:MediaContentRowData;}
const {section}=Astro.props;
---
<section id={section.id} class:list={['rk-media-content-row',{'rk-media-content-reverse':section.reverse}]} data-component="MediaContentRow" aria-labelledby={`${section.id}-title`}>
  <div class="rk-section-inner rk-media-content-layout">
    <figure><HomeImage {...section.image}/>{section.caption && <figcaption>{section.caption}</figcaption>}</figure>
    <div class="rk-service-prose"><p class="rk-home-eyebrow">{section.eyebrow}</p><h2 id={`${section.id}-title`}>{section.title}</h2><RichContent nodes={section.body}/>
      <div class="rk-media-row-links">{section.links.map(link=><a href={link.href}>{link.label} <span aria-hidden="true">→</span></a>)}</div>
    </div>
  </div>
</section>
