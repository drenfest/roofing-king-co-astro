---
import ServiceIcon from './ServiceIcon.astro';
import editorial from '../data/service-editorial.json';
interface Props { path?: string; headingLevel?:2|3; title?:string; description?:string; href?:string; label?:string; }
const {href:destination,label='Explore storm damage',path='/',headingLevel=2,title='Hail or Wind Damage to Your Home?',description='Have your roof, siding and gutters inspected. Explore repairs, storm-damage documentation and the next steps for your home.'}=Astro.props;
const Heading=headingLevel===3?'h3':'h2';
const localPath=`/${path.split('/').filter(Boolean)[0]}/storm-damage/`;
const href=destination||(localPath in editorial?localPath:'/storm-damage/');

---
<aside class="rk-storm-callout" aria-label="Storm damage inspections" data-component="StormDamageCallout">
  <picture class="rk-storm-photo" aria-hidden="true">
    <source media="(max-width:600px)" srcset="/media/weather/orange-lightning-mobile-640.webp"/>
    <img src="/media/weather/orange-lightning-1600.webp" srcset="/media/weather/orange-lightning-960.webp 960w, /media/weather/orange-lightning-1600.webp 1600w" sizes="100vw" width="1600" height="533" alt="" loading="lazy" decoding="async"/>
  </picture>
  <svg class="rk-storm-weather" viewBox="0 0 1440 280" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true" focusable="false">
    <g class="rk-weather-wind">
      <path d="M-90 99C70-5 231 103 390 42S640-29 760 9"/>
      <path d="M-75 119C83 16 243 122 401 61S644-7 770 26"/>
      <path d="M-60 139C98 37 256 142 412 81S650 16 780 44"/>
      <path d="M-50 260C141 171 316 303 535 233S756 152 802 192C842 229 777 257 755 226C742 205 766 190 780 206"/>
      <path d="M-39 280C152 191 326 323 546 253S746 176 782 204"/>
      <path d="M1215 258C1342 157 1431 268 1520 178M1231 277C1356 178 1448 288 1535 197"/>
    </g>
  </svg>
  <div class="rk-storm-callout-inner">
    <div class="rk-storm-callout-copy"><p class="rk-home-eyebrow">After the storm</p><Heading class="rk-storm-callout-heading">{title}</Heading><p>{description}</p>
      <nav aria-label="Storm damage resources"><a href="/storm-damage/hail/">Hail damage</a><a href="/storm-damage/wind/">Wind damage</a><a href="/storm-damage/insurance-claims/">Insurance documentation</a></nav>
    </div>
    <a class="rk-button rk-button-primary" href={href}>{label}<ServiceIcon name="arrow"/></a>
  </div>
</aside>
<style>
  .rk-storm-callout{background:#242321;color:#f8f4eb;position:relative;isolation:isolate;overflow:hidden;clip-path:polygon(0 22px,100% 0,100% calc(100% - 22px),0 100%);}
  .rk-storm-callout::before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,#242321f5 0%,#242321e0 38%,#24232170 64%,#24232120 100%);pointer-events:none;}
  .rk-storm-photo{position:absolute;inset:0;z-index:-2;pointer-events:none;}
  .rk-storm-photo img{width:100%;height:100%;object-fit:cover;object-position:center;}
  .rk-storm-weather{position:absolute;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none;}
  .rk-weather-wind{stroke:#f7e8d2;stroke-width:1;opacity:.095;stroke-linecap:round;}
  .rk-storm-callout-inner{max-width:1240px;margin:auto;padding:3.5rem 2rem;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:3rem;align-items:center;}
  .rk-storm-callout .rk-storm-callout-heading{color:#fff9ef;font-size:clamp(1.4rem,2.1vw,1.9rem);line-height:1.25;margin:.6rem 0 .7rem;text-transform:none;}
  .rk-storm-callout-copy>p:not(.rk-home-eyebrow){color:#ded6ca;margin:0;max-width:65ch;font-size:.95rem;line-height:1.7;}
  .rk-storm-callout .rk-home-eyebrow{color:#ffad66;margin:0;font-size:.7rem;letter-spacing:.12em;display:flex;align-items:center;gap:.65rem;}
  .rk-storm-callout .rk-home-eyebrow::before{content:"";width:24px;height:1px;background:currentColor;}
  .rk-storm-callout nav{display:flex;flex-wrap:wrap;gap:.5rem 1.2rem;margin-top:1rem;font-size:.8rem;font-weight:550;}
  .rk-storm-callout nav a{color:#f8f4eb;text-underline-offset:5px;text-decoration-color:#a36a3d;}
  .rk-storm-callout nav a:hover{color:#ffad66;text-decoration-color:currentColor;}
  .rk-storm-callout a:focus-visible{outline:2px solid #ffad66;outline-offset:6px;}
  .rk-storm-callout-inner>.rk-button{font-size:.8rem;white-space:nowrap;}
  @media(hover:hover) and (prefers-reduced-motion:no-preference){.rk-storm-callout .rk-weather-wind{transition:transform 1.2s ease;}.rk-storm-callout:hover .rk-weather-wind{transform:translateX(9px);}}
  @media(max-width:900px){.rk-storm-callout-inner{grid-template-columns:minmax(0,1fr);gap:1.5rem;}.rk-storm-callout-inner>.rk-button{justify-self:start;}}
  @media(max-width:600px){.rk-storm-callout{clip-path:polygon(0 12px,100% 0,100% calc(100% - 12px),0 100%);}.rk-storm-callout-inner{padding:2.6rem 1.25rem;}.rk-storm-weather{width:180%;left:-40%;}.rk-storm-callout::before{background:linear-gradient(90deg,#242321f0,#242321b8 68%,#24232188);}.rk-storm-photo img{object-position:65% center;}.rk-storm-callout .rk-storm-callout-heading{max-width:25ch;}.rk-storm-callout-inner>.rk-button{white-space:normal;}.rk-storm-callout nav{gap:.65rem 1.1rem;}}
</style>
