---
import ServiceIcon from './ServiceIcon.astro';
import editorial from '../data/service-editorial.json';
interface Props { path?: string; headingLevel?:2|3; title?:string; description?:string; }
const {path='/',headingLevel=2,title='Hail or Wind Damage to Your Home?',description='Have your roof, siding and gutters inspected. Explore repairs, storm-damage documentation and the next steps for your home.'}=Astro.props;
const Heading=headingLevel===3?'h3':'h2';
const localPath=`/${path.split('/').filter(Boolean)[0]}/storm-damage/`;
const href=localPath in editorial?localPath:'/storm-damage/';
---
<aside class="rk-storm-callout" aria-label="Storm damage inspections" data-component="StormDamageCallout">
  <div class="rk-storm-callout-inner">
    <span class="rk-storm-callout-icon"><ServiceIcon name="storm"/></span>
    <div class="rk-storm-callout-copy"><p class="rk-home-eyebrow">After the storm</p><Heading class="rk-storm-callout-heading">{title}</Heading><p>{description}</p>
      <nav aria-label="Storm damage resources"><a href="/storm-damage/hail/">Hail damage</a><a href="/storm-damage/wind/">Wind damage</a><a href="/storm-damage/insurance-claims/">Insurance documentation</a></nav>
    </div>
    <a class="rk-button rk-button-primary" href={href}>Explore storm damage<ServiceIcon name="arrow"/></a>
  </div>
</aside>
<style>
  .rk-storm-callout{background:#f5efe3;border-block:1px solid #e5dccb;position:relative;}
  .rk-storm-callout-inner{max-width:1240px;margin:auto;padding:2rem 2rem;display:grid;grid-template-columns:56px minmax(0,1fr) auto;gap:1.4rem;align-items:center;}
  .rk-storm-callout-icon{display:grid;place-items:center;align-self:start;width:56px;height:60px;background:#242321;color:#ffb76f;clip-path:polygon(0 0,80% 0,100% 20%,100% 100%,20% 100%,0 80%);}
  .rk-storm-callout .rk-storm-callout-heading{font-size:clamp(1.25rem,2.1vw,1.65rem);line-height:1.25;margin:.3rem 0 .5rem;}
  .rk-storm-callout-copy>p:not(.rk-home-eyebrow){margin:0;max-width:65ch;font-size:1rem;line-height:1.6;}
  .rk-storm-callout .rk-home-eyebrow{margin:0;font-size:.75rem;}
  .rk-storm-callout nav{display:flex;flex-wrap:wrap;gap:.3rem 1.2rem;margin-top:.65rem;font-size:.9rem;font-weight:650;}
  .rk-storm-callout nav a{text-underline-offset:4px;text-decoration-color:#ce681f;}
  .rk-storm-callout nav a:hover{color:#a63d00;}
  @media(max-width:1000px){.rk-storm-callout-inner{grid-template-columns:48px minmax(0,1fr);}.rk-storm-callout-icon{width:48px;height:52px;}.rk-storm-callout-inner>.rk-button{grid-column:2;justify-self:start;}}
  @media(max-width:500px){.rk-storm-callout-inner{padding:1.5rem 1.1rem;gap:.8rem;}.rk-storm-callout-inner>.rk-button{grid-column:1/-1;}.rk-storm-callout nav{gap:.5rem 1rem;}}
</style>
