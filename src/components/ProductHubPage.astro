---
import type { CollectionEntry } from 'astro:content';
import ProductLayout from '../layouts/ProductLayout.astro';
import catalog from '../data/product-catalog.json';
import HomeImage from './HomeImage.astro';
import BrandStrip from './BrandStrip.astro';
import type { BrandSection } from '../data/section-types';
import type { ProductPresentation } from '../data/product-types';
import {productHeroImage,productFamily} from '../data/product-presentation';
import ServiceIcon from './ServiceIcon.astro';
import SidingProductGuide from './SidingProductGuide.astro';
interface Hub {heading:string;eyebrow:string;copy:string;breadcrumbs:{label:string;href?:string}[];brands?:BrandSection;logo?:{src:string;alt:string};cards:{title:string;description:string;href:string;action:string;product?:string;image?:{src:string;alt:string}}[];guidance?:string;secondaryTitle:string;secondary:{title:string;copy:string;href?:string;label?:string}[];reference?:{label:string;href:string};}
interface Props {page:CollectionEntry<'pages'>;data:Hub;}
const {page,data}=Astro.props;
const products:Record<string,ProductPresentation>=catalog;
---
<ProductLayout {page} {...data}>
  {data.cards.length>0 && <section id="product-range" class="rk-section-inner rk-product-range" aria-labelledby="product-range-title">
    <div class="rk-product-section-heading"><p class="rk-home-eyebrow">Explore the collection</p><h2 id="product-range-title">{data.breadcrumbs.at(-1)?.label==='Products'?'Materials for your exterior':data.breadcrumbs.at(-1)?.label}</h2></div>
    <div class="rk-product-hub-cards" data-count={data.cards.length}>{data.cards.map(card=>{
      const product=card.product?products[card.product]:undefined;
      const color=product?.colors.find(c=>c.id===product.defaultColorId);
      const picture=color?{...color.image,alt:`${card.product} in ${color.name}`,caption:`${card.product} · ${color.name}`} : productHeroImage(card.href);
      return <a class="rk-product-hub-card" href={card.href}>
        <figure><img src={picture.src} srcset={picture.srcset} sizes="(max-width:760px) 100vw, 50vw" width={picture.width} height={picture.height} alt={picture.alt} loading="lazy" decoding="async"/><figcaption>{picture.caption}</figcaption></figure>
        <div class="rk-product-hub-card-body">{card.image&&<HomeImage {...card.image} class="rk-product-category-logo" sizes="160px"/>}<h3>{card.title}</h3><p>{card.description}</p><span class="rk-product-card-action">{card.action}<span aria-hidden="true">→</span></span></div>
      </a>;
    })}</div>
  </section>}
  {data.guidance==='siding'?<SidingProductGuide/>:<section id={data.cards.length?undefined:'product-range'} class="rk-product-guidance-band" aria-labelledby="product-guidance-title"><div class="rk-section-inner rk-product-hub-guidance">
    <div class="rk-product-section-heading"><p class="rk-home-eyebrow">{data.breadcrumbs.at(-1)?.label} · buying considerations</p><h2 id="product-guidance-title">{data.secondaryTitle}</h2></div>
    <div class="rk-product-guidance-grid" data-count={data.secondary.length}>{data.secondary.map((item,index)=><article><span class="rk-product-guidance-icon"><ServiceIcon name={productFamily(page.data.permalink)==='roofing'?(['shield','storm','roof','cost'] as const)[index%4]:(['roof','shield','cost','check'] as const)[index%4]}/></span><h3>{item.title}</h3><p>{item.copy}</p>{item.href&&<a href={item.href}>{item.label}<span aria-hidden="true">→</span></a>}</article>)}</div>
    {data.reference&&<p class="rk-product-guidance-reference"><a href={data.reference.href} target="_blank" rel="noopener noreferrer">{data.reference.label} <span aria-hidden="true">↗</span></a></p>}
  </div></section>}
  {data.brands && <BrandStrip brands={data.brands}/>}
</ProductLayout>
