---
import { media } from '../data/media';
interface Props { src: string; alt: string; class?: string; sizes?: string; eager?: boolean; width?:number; height?:number; srcset?:string; }
const { src, alt, class: className, sizes = '(max-width: 760px) 100vw, 50vw', eager = false, width, height, srcset } = Astro.props;
const dimensions = media[src as keyof typeof media];
const variants = dimensions?.variants || [];
const fallback = variants.find(v => v.width >= 800) || variants.at(-1);
---
<img src={fallback?.src || src} srcset={variants.length ? variants.map(v => `${v.src} ${v.width}w`).join(', ') : srcset}
  sizes={variants.length || srcset ? sizes : undefined} alt={alt} class={className}
  width={dimensions?.width || width} height={dimensions?.height || height}
  loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} />
