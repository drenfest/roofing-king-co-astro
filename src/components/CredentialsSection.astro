---
import ServiceIcon from './ServiceIcon.astro';
interface Props {
  section: {
    eyebrow:string;title:string;description:string;
    items:{title:string;description:string;label:string;href:string;mark:string;image?:{src:string;width:number;height:number}}[];
  };
}
const {section}=Astro.props;
---
<section class="rk-landing-section rk-landing-credentials" aria-labelledby="roofing-credentials-title">
  <div class="rk-section-inner">
    <div class="rk-credentials-heading">
      <div><p class="rk-home-eyebrow">{section.eyebrow}</p><h2 id="roofing-credentials-title">{section.title}</h2></div>
      <p>{section.description}</p>
    </div>
    <div class:list={["rk-landing-credential-list",{"rk-credentials-even":section.items.length===4}]}>
      {section.items.map(item=><article>
        <div class="rk-credential-symbol" aria-hidden="true">
          <div class="rk-credential-emblem">{item.image?<img {...item.image} alt="" loading="lazy"/>:<ServiceIcon name="shield"/>}</div>
          <span>{item.mark}</span>
        </div>
        <h3>{item.title}</h3><p>{item.description}</p>
        <div class="rk-credential-actions"><a href={item.href}>{item.label}<ServiceIcon name="arrow"/></a>
        </div>
      </article>)}
    </div>
  </div>
</section>

<style>
.rk-landing-credential-list.rk-credentials-even{grid-template-columns:repeat(2,minmax(0,1fr));}
@media(max-width:760px){.rk-landing-credential-list.rk-credentials-even{grid-template-columns:minmax(0,1fr);}}
</style>
