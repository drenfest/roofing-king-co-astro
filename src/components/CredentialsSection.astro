---
import ServiceIcon from './ServiceIcon.astro';
interface Props {
  section: {
    eyebrow:string;title:string;description:string;note:string;
    items:{title:string;description:string;label:string;href:string;mark:string;image?:{src:string;width:number;height:number};related?:{label:string;href:string}}[];
  };
}
const {section}=Astro.props;
---
<section class="rk-landing-section rk-landing-credentials" aria-labelledby="roofing-credentials-title">
  <div class="rk-section-inner">
    <div class="rk-credentials-heading">
      <div><p class="rk-home-eyebrow">{section.eyebrow}</p><h2 id="roofing-credentials-title">{section.title}</h2></div>
      <p>{section.description}</p>
    </div>
    <div class="rk-landing-credential-list">
      {section.items.map(item=><article>
        <div class="rk-credential-symbol" aria-hidden="true">
          {item.image?<img {...item.image} alt="" loading="lazy"/>:<ServiceIcon name="shield"/>}
          <span>{item.mark}</span>
        </div>
        <h3>{item.title}</h3><p>{item.description}</p>
        <div class="rk-credential-actions"><a href={item.href}>{item.label}<ServiceIcon name="arrow"/></a>
          {item.related&&<a class="rk-credential-related" href={item.related.href}>{item.related.label}</a>}
        </div>
      </article>)}
    </div>
    <p class="rk-credential-note"><ServiceIcon name="shield"/><span>{section.note}</span></p>
  </div>
</section>
