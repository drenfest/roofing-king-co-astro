---
import type { BrandSection } from '../data/section-types';
import brandPages from '../data/brand-pages.json';
import library from '../data/brand-library.json';
interface Props { brands: BrandSection; headingLevel?:2|3; }
const { brands, headingLevel=2 } = Astro.props;
const Heading=headingLevel===3?'h3':'h2';
const records=library as Record<string,{name:string;pageKey:string;image:{src:string;alt:string;width:number;height:number}}>;
const selected=[...new Set(brands.brandIds)].map(id=>{
  const record=records[id];
  if(!record)throw new Error(`Unknown BrandStrip brand ID: ${id}`);
  const href=(brandPages as Record<string,string>)[record.pageKey];
  if(!href)throw new Error(`Missing brand destination: ${id}`);
  return {id,...record,href};
});
---
{selected.length>0 && <section class="rk-home-brands rk-block-trusted-brands" aria-label="Trusted brands">
  <div class="rk-section-inner rk-brands-inner">
    <div class="rk-brands-heading"><p class="rk-home-eyebrow">{brands.eyebrow}</p><Heading class="rk-brand-heading-title">{brands.title}</Heading><p>{brands.description}</p></div>
    <div class="rk-home-brand-list" style={`--brand-columns:${Math.min(selected.length,4)};--brand-mobile-columns:${Math.min(selected.length,2)};--brand-max-width:${selected.length*240}px`}>{selected.map(brand=><a class="rk-home-brand-mark" href={brand.href} data-brand-id={brand.id} aria-label={`Explore ${brand.name}`}><span class="rk-shingle-bg" aria-hidden="true"></span><img {...brand.image} loading="lazy" decoding="async"/></a>)}</div>
  </div>
</section>}
<style>
  .rk-home-brand-mark:focus-visible{outline:3px solid #bd5207;outline-offset:-5px;}
  .rk-home-brand-list{grid-template-columns:repeat(var(--brand-columns),minmax(0,1fr));width:100%;max-width:var(--brand-max-width);}
  .rk-home-brand-mark img{width:auto;height:auto;max-width:min(76%,172px);max-height:58px;object-fit:contain;}
  @media(max-width:1000px){
    section.rk-block-trusted-brands .rk-brands-inner{grid-template-columns:minmax(0,1fr);gap:1.5rem;}
    section.rk-block-trusted-brands .rk-home-brand-list{width:100%;min-width:0;justify-self:start;}
  }
  @media(max-width:760px){
    section.rk-block-trusted-brands .rk-home-brand-list{grid-template-columns:repeat(var(--brand-mobile-columns),minmax(0,1fr));gap:1rem;}
    section.rk-block-trusted-brands .rk-home-brand-mark{min-width:0;min-height:104px;}
  }
</style>
