---
import type {ServiceCopySection} from '../data/section-types';
import HomeImage from './HomeImage.astro';
import RichContent from './RichContent.astro';
import ServiceSystemDiagram from './ServiceSystemDiagram.astro';
interface Props {section:ServiceCopySection;index:number;theme:string;}
const {section,index,theme}=Astro.props;
const illustrated=section.variant==='media';
---
<section id={section.id} class:list={['rk-copy-band',`rk-copy-${section.tone}`,{'rk-copy-reverse':index%4===2,'rk-copy-media-band':illustrated}]} aria-labelledby={`${section.id}-title`} data-component="ServiceContentBand">
  <div class="rk-section-inner">
    {illustrated?<div class="rk-copy-media-layout"><figure class="rk-copy-figure"><HomeImage {...section.image}/><figcaption>{section.caption}</figcaption></figure><div class="rk-copy-text"><p class="rk-home-eyebrow">{section.eyebrow||'Materials, details & the work involved'}</p><h2 id={`${section.id}-title`}>{section.title}</h2><RichContent nodes={section.body}/><div class="rk-copy-detail-list">{section.cards.map(card=><div id={card.id}><h3 id={card.id?`${card.id}-title`:undefined}>{card.title}</h3><RichContent nodes={card.body}/></div>)}</div></div></div>:
    <><div class="rk-copy-band-heading"><div><p class="rk-home-eyebrow">{section.eyebrow||'Understand your options'}</p><h2 id={`${section.id}-title`}>{section.title}</h2><RichContent nodes={section.body}/></div><ServiceSystemDiagram {theme}/></div>{section.cards.length>0&&<div class:list={['rk-copy-option-grid',{'rk-copy-two-options':section.cards.length===2}]}>{section.cards.map(card=><article class="rk-copy-option" id={card.id}><span class="rk-copy-option-rule" aria-hidden="true"></span><h3 id={card.id?`${card.id}-title`:undefined}>{card.title}</h3><RichContent nodes={card.body}/></article>)}</div>}</>}
  </div>
  <slot/>
</section>
