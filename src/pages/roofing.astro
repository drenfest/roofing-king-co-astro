---
import { getCollection } from 'astro:content';
import ServiceLanding from '../layouts/ServiceLanding.astro';
import services from '../data/service-pages.json';
import landing from '../data/roofing-landing.json';
import type { BrandSection } from '../data/section-types';
const page=(await getCollection('pages')).find(page=>page.data.permalink==='/roofing/')!;
---
<ServiceLanding {page} data={landing} brands={services['/roofing/'].sections.find(section=>section.type==='brands') as BrandSection}/>
