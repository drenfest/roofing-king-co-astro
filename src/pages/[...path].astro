---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import RoofrEstimator from '../components/RoofrEstimator.svelte';
import roofr from '../data/roofr.json';
import services from '../data/service-pages.json';
import hubs from '../data/product-pillar.json';
import details from '../data/product-details.json';
import ServiceTopics from '../components/ServiceTopics.astro';
import {serviceOpening} from '../data/service-opening';
import '../styles/service-landing.css';
import editorial from '../data/service-editorial.json';
export async function getStaticPaths() {
  return (await getCollection('pages')).filter(page => page.data.permalink !== '/' && page.data.permalink !== '/reviews/' && !(page.data.permalink in services) && !(page.data.permalink in hubs) && !(page.data.permalink in details) && !(page.data.permalink in editorial)).map(page => ({
    params: { path: page.data.permalink === '/' ? undefined : page.data.permalink.slice(1, -1) },
    props: { page },
  }));
}
interface Props { page: CollectionEntry<'pages'>; }
const { page } = Astro.props;
const { Content } = await render(page);
const opening=serviceOpening(page.data.permalink);
---
<SiteLayout title={page.data.title} description={page.data.description} canonicalPath={page.data.canonicalPath}>
  <div data-content-source={page.data.source} data-review-status={page.data.reviewStatus}>
    {opening?.after!==undefined ? <><Fragment set:html={opening.before}/><ServiceTopics section={opening.opening}/><Fragment set:html={opening.after}/></> : <Content />}
    {roofr.calculatorPaths.includes(page.data.permalink) && <RoofrEstimator client:load />}
  </div>
</SiteLayout>
