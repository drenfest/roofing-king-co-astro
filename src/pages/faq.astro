---
import DocumentLayout from '../layouts/DocumentLayout.astro';
import SiteHeader from '../components/SiteHeader.svelte';
import SiteFooter from '../components/SiteFooter.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ServiceExplorer from '../components/ServiceExplorer.svelte';
import FAQSection from '../components/FAQSection.astro';
import ResourceLinks from '../components/ResourceLinks.astro';
import QuoteSection from '../components/QuoteSection.astro';
import {faqGroups} from '../data/faq-page';
import {hero} from '../data/home.json';
import library from '../data/project-gallery.json';
import '../styles/base.css';
import '../styles/home.css';
import '../styles/home-interactions.css';
import '../styles/services.css';
import '../styles/service-landing.css';
import '../styles/faq.css';
const image=library.items[1].src;
---
<DocumentLayout title="Frequently asked questions" description="Find answers about Roof King inspections, roof repairs, storm damage, siding, gutters, estimates and workmanship coverage. Browse questions by service." canonicalPath="/faq/" {image}>
 <SiteHeader client:load/>
 <main id="content" class="rk-site-main rk-service-landing rk-faq-page" data-landing-build="editorial" data-component="FAQPage">
  <PageHero variant="service" hero={{...hero,image,eyebrow:'Roof King questions & answers',title:'Answers for your roofing and exterior project.',description:'Explore inspection, repair, material and estimate questions before you plan work on your home. Choose a topic below to find the details that matter to your project.',bookingUrl:'#faq-questions',bookingLabel:'Browse the questions',note:'Need an answer about your property? Call our team.'}}/>
  <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Frequently asked questions'}]}/>
  <section id="faq-questions" class="rk-faq-directory"><div class="rk-section-inner">
   <ServiceExplorer id="faq-topics" label="Choose a question topic" scrollable tabs={faqGroups.map(group=>({id:group.id,label:group.label}))} client:load>
    {faqGroups.map(group=><section id={group.id} class="rk-faq-topic" data-service-panel aria-labelledby={`${group.id}-heading`}><span id={`${group.id}-heading`} hidden>{group.title}</span><FAQSection contained section={{eyebrow:'Questions from homeowners',title:group.title,description:group.description,items:group.items}}/><nav class="rk-faq-topic-links" aria-label={`Explore ${group.label.toLowerCase()}`}><ResourceLinks links={group.links}/></nav></section>)}
   </ServiceExplorer>
  </div></section>
  <QuoteSection quote={{eyebrow:'Still have a question?',title:'Let’s talk about your home',description:'Tell us what needs attention and where your property is. For questions about a current leak, storm damage or a planned improvement, you can call our team or book an inspection.'}}/>
 </main><SiteFooter/>
</DocumentLayout>
