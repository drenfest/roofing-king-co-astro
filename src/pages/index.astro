---
import { getCollection } from 'astro:content';
import DocumentLayout from '../layouts/DocumentLayout.astro';
import SiteHeader from '../components/SiteHeader.svelte';
import SiteFooter from '../components/SiteFooter.astro';
import HomeHero from '../components/HomeHero.astro';
import StormDamageCallout from '../components/StormDamageCallout.astro';
import HomeTrust from '../components/HomeTrust.astro';
import HomeServices from '../components/HomeServices.astro';
import HomeCardSection from '../components/HomeCardSection.astro';
import FeaturedArticles from '../components/FeaturedArticles.astro';
import HomeConfidence from '../components/HomeConfidence.astro';
import HomeWorkmanship from '../components/HomeWorkmanship.astro';
import ProjectGallery from '../components/ProjectGallery.svelte';
import ComparisonSection from '../components/ComparisonSection.astro';
import QuoteSection from '../components/QuoteSection.astro';
import FAQSection from '../components/FAQSection.astro';
import home, { comparison, quote } from '../data/home.json';
import type { HeadingData, RichNode } from '../data/section-types';
import library from '../data/project-gallery.json';
import {galleryFor} from '../data/project-gallery';
import '../styles/base.css';
import '../styles/home.css';
import '../styles/home-interactions.css';
const page = (await getCollection('pages')).find(page => page.data.permalink === '/')!;
const faq = home.faq as HeadingData & {items:{question:string;answer:RichNode[]}[]};
---
<DocumentLayout title="Columbus Roofing Contractor & Siding"description={page.data.description} canonicalPath="/">
  <SiteHeader client:load />
  <main id="content" class="rk-site-main">
    <article class="rk-home" data-homepage-build="astro-components">
      <HomeHero /><HomeTrust /><StormDamageCallout /><HomeServices /><HomeCardSection kind="offers" /><HomeConfidence />
      <ProjectGallery {...galleryFor('all')} id="projects" title={library.title} titleEmphasis={library.titleEmphasis} description={library.description} tone="brand" client:visible />
      <HomeWorkmanship /><HomeCardSection kind="reviews" /><FeaturedArticles family="local" city="Columbus" path="/" />
      <ComparisonSection {comparison} />
      <FAQSection section={faq} />
      <QuoteSection {quote} />
    </article>
  </main>
  <SiteFooter />
</DocumentLayout>
