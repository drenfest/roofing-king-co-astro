---
import { getCollection } from 'astro:content';
import ServicePage from '../../../layouts/ServicePage.astro';
import services from '../../../data/service-pages.json';
import type { ServicePageData } from '../../../data/section-types';
const page=(await getCollection('pages')).find(page=>page.data.permalink==='/roofing/gaf/master-elite/')!;
---
<ServicePage {page} data={services['/roofing/gaf/master-elite/'] as ServicePageData}/>
