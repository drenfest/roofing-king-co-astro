---
import type { CollectionEntry } from 'astro:content';
import DocumentLayout from './DocumentLayout.astro';
import SiteHeader from '../components/SiteHeader.svelte';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuoteSection from '../components/QuoteSection.astro';
import ProductHero from '../components/ProductHero.astro';
import {productHeroImage} from '../data/product-presentation';
import '../styles/base.css';
import '../styles/home.css';
import '../styles/home-interactions.css';
import '../styles/services.css';
import '../styles/products.css';
interface Props {page:CollectionEntry<'pages'>;heading:string;eyebrow:string;copy:string;breadcrumbs:{label:string;href?:string}[];image?:string;productKey?:string;logo?:{src:string;alt:string};}
const {page,heading,eyebrow,copy,breadcrumbs,image,productKey,logo}=Astro.props;
const heroImage=productHeroImage(page.data.permalink,productKey);
---
<DocumentLayout title={page.data.title} description={page.data.description} canonicalPath={page.data.canonicalPath} image={image||heroImage.src}>
  <slot name="head" slot="head"/>
  <SiteHeader client:load/>
  <main id="content" class="rk-product-pillar" data-product-pillar="native">
    <ProductHero {heading} {eyebrow} {copy} path={page.data.permalink} image={heroImage} detail={!!productKey} {logo}/>
    <Breadcrumbs items={breadcrumbs}/>
    <slot/>
    <QuoteSection quote={{eyebrow:'Plan your project',title:'Talk with Roof King about your project',description:'Discuss product options, availability and installation for your home.'}}/>
  </main>
  <SiteFooter/>
</DocumentLayout>
