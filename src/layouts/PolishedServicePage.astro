---
import type {CollectionEntry} from 'astro:content';
import type {HeadingData,RichNode,ServicePathsData,ServiceCopyData} from '../data/section-types';
import editorial from '../data/service-editorial.json';
import fullCopy from '../data/service-copy.json';
import reference from '../data/roofing-landing.json';
import {items as featured} from '../data/featured-reviews.json';
import site from '../data/site.json';
import {hero as homeHero} from '../data/home.json';
import DocumentLayout from './DocumentLayout.astro';
import SiteHeader from '../components/SiteHeader.svelte';
import SiteFooter from '../components/SiteFooter.astro';
import LandingHero from '../components/LandingHero.astro';
import StormDamageCallout from '../components/StormDamageCallout.astro';
import ServicePaths from '../components/ServicePaths.astro';
import ServiceArticle from '../components/ServiceArticle.astro';
import ServiceContentBand from '../components/ServiceContentBand.astro';
import RichContent from '../components/RichContent.astro';
import {hasServiceChildren} from '../data/service-hierarchy';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReviewSection from '../components/ReviewSection.astro';
import CredentialsSection from '../components/CredentialsSection.astro';
import BrandStrip from '../components/BrandStrip.astro';
import FAQSection from '../components/FAQSection.astro';
import QuoteExperience from '../components/QuoteExperience.svelte';
import RoofrEstimator from '../components/RoofrEstimator.svelte';
import ServiceIcon from '../components/ServiceIcon.astro';
import '../styles/base.css';
import '../styles/home.css';
import '../styles/home-interactions.css';
import '../styles/services.css';
import '../styles/service-landing.css';
import '../styles/service-editorial.css';
interface Props {page:CollectionEntry<'pages'>;data:(typeof editorial)[keyof typeof editorial]&{seoTitle?:string};}
const {page,data}=Astro.props;
const content=(fullCopy as unknown as Record<string,ServiceCopyData>)[page.data.permalink];
if(!content)throw new Error('Missing full service content: '+page.data.permalink);
const isRoof=['repair','replacement','materials','gaf','certification','metal','roofing-local','roof-cost','calculator','hail','wind','storm','claims'].includes(data.family);
const credentials={...reference.credentials,eyebrow:'Roof King credentials & workmanship',title:'Know the Team. Know the Work.',description:'Check our independent business record and review the written coverage for the materials and installation.',items:isRoof?reference.credentials.items:[{...reference.credentials.items[1],description:'Roof King’s BBB profile lists accreditation, an A+ business rating and independent customer feedback.'},{...reference.credentials.items[2],description:'Review Roof King’s written workmanship terms for your project. Manufacturer product coverage is separate.'},{title:'Materials & Installation, Explained',description:'Your estimate should identify the actual materials, preparation, installation and cleanup, including how additional repairs are approved.',label:'Discuss your project',href:'#estimate',mark:'Project details'}]};
const budgetIndex=content.sections.findIndex(section=>/estimate|cost|price|proposal|records/i.test(section.title));
const budget=budgetIndex>=0?content.sections[budgetIndex]:null;
const showStormCallout=['repair','replacement','roofing-local','roof-cost','siding','siding-cost','siding-replacement','gutters','commercial','commercial-repair','commercial-replacement','commercial-siding','windows','local'].includes(data.family);
const sections=content.sections.filter((_section,index)=>index!==budgetIndex);
const schema={'@context':'https://schema.org','@type':'Service',name:data.title,serviceType:data.serviceType,description:data.description,url:new URL(page.data.permalink,site.url).href,provider:{'@id':site.url+'/#business'},areaServed:{'@type':'City',name:data.city+', Ohio'}};
---
<DocumentLayout title={data.seoTitle||data.title} description={data.description} canonicalPath={page.data.canonicalPath} image={data.hero.image.src}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\u003c')}/>
  <SiteHeader client:load/>
  <main id="content" class="rk-site-main rk-service-landing"><article class="rk-polished-service rk-full-service" data-service-build="astro-components" data-landing-build="editorial" data-service-family={data.family} data-pdf-entry={content.sourceId} data-content-source={page.data.source}>
    <LandingHero hero={{...data.hero,body:('body' in data.hero?data.hero.body:undefined) as RichNode[]|undefined}}/>
    <div class="rk-landing-trust"><div class="rk-section-inner"><a href={reference.credentials.items[1].href}><ServiceIcon name="shield"/><span>BBB Accredited</span><span aria-hidden="true">↗</span></a><a href="/offers/5-year-workmanship-warranty/"><ServiceIcon name="check"/><span>Written workmanship coverage</span><span aria-hidden="true">↗</span></a><a href="/reviews/"><ServiceIcon name="building"/><span>Verified review sources</span><span aria-hidden="true">↗</span></a></div></div>
    <Breadcrumbs items={data.breadcrumbs}/>
    {hasServiceChildren(page.data.permalink)?<ServicePaths section={data.opening as ServicePathsData}/>:<ServiceArticle section={data.opening as ServicePathsData}/>}
    {showStormCallout&&<StormDamageCallout path={page.data.permalink}/>}
    {data.family==='calculator'&&<div class="rk-section-inner rk-editorial-estimator"><RoofrEstimator client:load/></div>}
    <ReviewSection section={{eyebrow:'Roof King customer reviews',title:'Hear From Roof King Customers',description:'Customer experiences from independent sources. Open each source badge to read the review.',reviewIds:featured.map(item=>item.id)}}/>
    <CredentialsSection section={credentials}/>
    {sections.map((section,index)=><><ServiceContentBand {section} {index} theme={content.theme}/>{index===Math.min(1,sections.length-1)&&data.brandIds.length>0&&<BrandStrip brands={{eyebrow:'Products for your project',title:'Explore the Brands Behind the Materials',description:'Compare the products, finishes and care information for your chosen materials.',brandIds:data.brandIds}}/>}</>)}
    <section id={budget?.id||'service-estimate-details'} class="rk-landing-section rk-landing-budget rk-roofing-planning rk-copy-estimate-band" aria-labelledby="service-budget-title"><div class="rk-section-inner rk-landing-split">
      <div class="rk-landing-heading"><p class="rk-home-eyebrow">Your written estimate</p><h2 id="service-budget-title">{budget?.title||data.budget.title}</h2>
        {budget?<><RichContent nodes={budget.body}/>{budget.cards.map(card=><div class="rk-copy-budget-detail"><h3>{card.title}</h3><RichContent nodes={card.body}/></div>)}</>:<><p>{data.budget.description}</p><ul class="rk-budget-checks">{data.budget.items.map(item=><li><ServiceIcon name="check"/>{item}</li>)}</ul></>}
        <a class="rk-button rk-button-primary" href="#estimate">{data.hero.action}<ServiceIcon name="arrow"/></a>
      </div>
      <aside class="rk-budget-financing"><span class="rk-financing-icon"><ServiceIcon name="cost"/></span><p class="rk-home-eyebrow">Planning your project</p><h3>Financing Options</h3><p>Explore ways to spread the cost of your project. Ask our team about current options, then review lender rates and repayment terms.</p><a class="rk-button rk-button-outline" href="/offers/flexible-financing/">Explore financing<ServiceIcon name="arrow"/></a><p class="rk-landing-small">Financing is subject to lender approval and applicable terms.</p></aside>
    </div></section>
    <FAQSection section={data.faq as HeadingData & {items:{question:string;answer:RichNode[]}[]}}/>
    <section id="estimate" class="rk-landing-section rk-home-final-cta rk-landing-estimate"><div class="rk-section-inner rk-quote-strip-inner"><div class="rk-landing-heading"><p class="rk-home-eyebrow">Talk with Roof King</p><h2>{data.quote.title}</h2><RichContent nodes={content.closingBody}/><div class="rk-estimate-contact"><a class="rk-landing-estimate-phone" href={site.phoneHref}><span>Talk with our team</span><strong>{site.phone}</strong></a><a class="rk-button rk-button-primary" href={homeHero.bookingUrl}>Book an inspection<ServiceIcon name="arrow"/></a></div></div><QuoteExperience modalTitle={data.quote.title} modalDescription={data.quote.description} showRating={false} client:load/></div></section>
  </article></main><SiteFooter/>
</DocumentLayout>
