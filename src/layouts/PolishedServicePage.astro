---
import ServiceComparison from '../components/ServiceComparison.astro';
import type {CollectionEntry} from 'astro:content';
import type {HeadingData,RichNode,ServicePathsData,ServiceCopyData} from '../data/section-types';
import editorial from '../data/service-editorial.json';
import fullCopy from '../data/service-copy.json';
import reference from '../data/roofing-landing.json';
import {reviewSelectionForService} from '../data/service-reviews';
import site from '../data/site.json';
import {hero as homeHero, trust} from '../data/home.json';
import DocumentLayout from './DocumentLayout.astro';
import SiteHeader from '../components/SiteHeader.svelte';
import SiteFooter from '../components/SiteFooter.astro';
import LandingHero from '../components/LandingHero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import roofingHeroes from '../data/roofing-heroes.json';
import serviceHeroes from '../data/service-heroes.json';
import StormDamageCallout from '../components/StormDamageCallout.astro';
import ServicePaths from '../components/ServicePaths.astro';
import ServiceArticle from '../components/ServiceArticle.astro';
import ServiceContentBand from '../components/ServiceContentBand.astro';
import RichContent from '../components/RichContent.astro';
import {hasServiceChildren} from '../data/service-hierarchy';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReviewSection from '../components/ReviewSection.astro';
import CredentialsSection from '../components/CredentialsSection.astro';
import BrandStrip from '../components/BrandStrip.astro';
import FAQSection from '../components/FAQSection.astro';
import QuoteExperience from '../components/QuoteExperience.svelte';
import RoofrEstimator from '../components/RoofrEstimator.svelte';
import ServiceIcon from '../components/ServiceIcon.astro';
import ServiceGallery from '../components/ServiceGallery.astro';
import FeaturedArticles from '../components/FeaturedArticles.astro';
import '../styles/base.css';
import '../styles/home.css';
import '../styles/home-interactions.css';
import '../styles/services.css';
import '../styles/service-landing.css';
import '../styles/service-editorial.css';
interface Props {page:CollectionEntry<'pages'>;data:(typeof editorial)[keyof typeof editorial]&{seoTitle?:string};}
const {page,data}=Astro.props;
const heroAsset=({...serviceHeroes,...roofingHeroes} as Record<string,{image:{src:string;alt:string};generated:boolean;caption?:string}>)[page.data.permalink];
const content=(fullCopy as unknown as Record<string,ServiceCopyData>)[page.data.permalink];
if(!content)throw new Error('Missing full service content: '+page.data.permalink);
const presentation=('reviewPresentation' in data?data.reviewPresentation:{}) as {batch?:string;credentialsTitle?:string;reviewsTitle?:string;brandsTitle?:string;brandsDescription?:string;brandsSectionId?:string;financeTitle?:string;financeDescription?:string;hideGallery?:boolean;hideArticles?:boolean;galleryTitle?:string;stormTitle?:string;stormDescription?:string;materialsTitle?:string};
const reviewSelection=reviewSelectionForService(data.family);
const reviewIds=reviewSelection.ids;
const isRoof=['repair','replacement','materials','gaf','certification','metal','roofing-local','roof-cost','calculator','hail','wind','storm','claims'].includes(data.family);
const credentials={...reference.credentials,eyebrow:'Roof King credentials & workmanship',title:presentation.credentialsTitle||'Know the Team. Know the Work.',description:'Check our independent business record and review the written coverage for the materials and installation.',items:isRoof?reference.credentials.items:[{...reference.credentials.items[1],description:'Roof King’s BBB profile lists accreditation, an A+ business rating and independent customer feedback.'},{...reference.credentials.items[2],description:'Review Roof King’s written workmanship terms for your project. Manufacturer product coverage is separate.'},{title:'Materials & Installation, Explained',description:'Your estimate should identify the actual materials, preparation, installation and cleanup, including how additional repairs are approved.',label:'Discuss your project',href:'#estimate',mark:'Project details'}]};
const budgetIndex=content.sections.findIndex(section=>content.budgetSectionId?section.id===content.budgetSectionId:/estimate|cost|price|proposal|records/i.test(section.title));
const budget=budgetIndex>=0?content.sections[budgetIndex]:null;
const showStormCallout=['repair','replacement','roofing-local','roof-cost','siding','siding-cost','siding-replacement','siding-types','gutters','commercial','commercial-repair','commercial-replacement','commercial-siding','windows','local'].includes(data.family);
const sections=content.sections.filter((_section,index)=>index!==budgetIndex);
if(presentation.batch&&!isRoof){credentials.items[2].title=presentation.materialsTitle||((data.family.includes('siding')?'Siding':'Gutter')+' materials, preparation and installation');}
if(data.family.includes('siding')){
 credentials.description='A family-owned Columbus company since 2020. Review our business record, written installation coverage and the actual siding products in your estimate.';
 credentials.items=[{...reference.credentials.items[1],title:'BBB Accredited, A+',description:'Roof King has been BBB Accredited since November 2020 and holds an A+ business rating.',mark:'A+ business rating'},{title:'5-year workmanship warranty',description:'Our siding installation is covered by a 5-year workmanship warranty. Manufacturer product coverage is separate.',href:'/offers/5-year-workmanship-warranty/',label:'Explore workmanship coverage',mark:'5-year coverage'},{title:'Siding brands we install',description:'Compare the vinyl, engineered wood and fiber cement products in our catalog. Your estimate names the exact line, profile, color and finish.',href:'/siding/types/',label:'Compare siding materials',mark:'Products and finishes'}];
}
const schema={'@context':'https://schema.org','@type':'Service',name:data.title,serviceType:data.serviceType,description:data.description,url:new URL(page.data.permalink,site.url).href,provider:{'@id':site.url+'/#business'},areaServed:{'@type':'City',name:data.city+', Ohio'}};
---
<DocumentLayout title={data.seoTitle||data.title} description={data.description} canonicalPath={page.data.canonicalPath} image={heroAsset?.image.src||data.hero.image.src}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\u003c')}/>
  <SiteHeader client:load/>
  <main id="content" class="rk-site-main rk-service-landing"><article class="rk-polished-service rk-full-service" data-service-build="astro-components" data-landing-build="editorial" data-service-family={data.family} data-content-review={presentation.batch} data-pdf-entry={content.sourceId} data-content-source={page.data.source}>
    <LandingHero hero={{...data.hero,image:heroAsset?.image||data.hero.image,body:('body' in data.hero?data.hero.body:undefined) as RichNode[]|undefined}} serviceName={data.serviceType} generatedImage={!!heroAsset?.generated} generatedCaption={heroAsset?.caption}/>
    <TrustStrip {trust}/>
    <Breadcrumbs items={data.breadcrumbs}/>
    {data.family==='local'||(hasServiceChildren(page.data.permalink)||(data.opening as ServicePathsData).variant==='tabs')?<ServicePaths section={data.opening as ServicePathsData}/>:<ServiceArticle section={data.opening as ServicePathsData}/>}
    {showStormCallout&&<StormDamageCallout path={page.data.permalink} headingLevel={presentation.batch?3:2} title={presentation.stormTitle||(data.family==='local'?`Storm damage to your ${data.city} roof or siding?`:presentation.batch?(data.family.includes('siding')?'Storm damage to siding, trim or flashing?':'Storm-damaged gutters or downspouts?'):undefined)} description={presentation.stormDescription||(presentation.batch?'Discuss the affected siding, gutters and adjoining roof details with Roof King. Review repair options and the documentation for your storm-damage inspection.':undefined)}/>}
    {data.family==='calculator'&&<div class="rk-section-inner rk-editorial-estimator"><RoofrEstimator client:load/></div>}
    {reviewIds.length>0&&<ReviewSection section={{eyebrow:'Roof King customer reviews',title:reviewSelection.exact?(presentation.reviewsTitle||'Hear From Roof King Customers'):(data.family==='local'?`Customer feedback for ${data.city} homeowners`:'Customer Experiences With Roof King'),description:reviewSelection.exact?'Recent customer feedback on related service work. Each card links to its published source.':'Customer experiences with Roof King. Each card identifies the work discussed and links to the original review.',reviewIds}}/>}
    <CredentialsSection section={credentials}/>
    {sections.map((section,index)=><>
      <ServiceContentBand {section} {index} theme={content.theme} pagePath={page.data.permalink}>
        {presentation.brandsSectionId===section.id&&data.brandIds.length>0&&<BrandStrip headingLevel={3} brands={{eyebrow:'Product manufacturers',title:presentation.brandsTitle||'Product manufacturers',description:presentation.brandsDescription||'',brandIds:data.brandIds}}/>}
      </ServiceContentBand>
      {!presentation.brandsSectionId&&index===Math.min(1,sections.length-1)&&data.brandIds.length>0&&<BrandStrip brands={{eyebrow:'Products for your project',title:presentation.brandsTitle||'Explore the Brands Behind the Materials',description:presentation.brandsDescription||'Compare the products, finishes and care information for your chosen materials.',brandIds:data.brandIds}}/>}
    </>)}
    <section id={budget?.id||'service-estimate-details'} class="rk-landing-section rk-landing-budget rk-roofing-planning rk-copy-estimate-band" aria-labelledby="service-budget-title"><div class="rk-section-inner rk-landing-split">
      <div class="rk-landing-heading"><p class="rk-home-eyebrow">Your written estimate</p><h2 id="service-budget-title">{budget?.title||data.budget.title}</h2>
        {budget?<><RichContent nodes={budget.body}/>{budget.cards.map(card=><div id={card.id} class="rk-copy-budget-detail"><h3 id={card.id?`${card.id}-title`:undefined}>{card.title}</h3><RichContent nodes={card.body}/></div>)}</>:<><p>{data.budget.description}</p><ul class="rk-budget-checks">{data.budget.items.map(item=><li><ServiceIcon name="check"/>{item}</li>)}</ul></>}
        <a class="rk-button rk-button-primary" href="#estimate">{data.hero.action}<ServiceIcon name="arrow"/></a>
      </div>
      <aside class="rk-budget-financing"><span class="rk-financing-icon"><ServiceIcon name="cost"/></span><p class="rk-home-eyebrow">Planning your project</p><h3>{presentation.financeTitle||'Financing Options'}</h3><p>{presentation.financeDescription||'Explore ways to spread the cost of your project. Ask our team about current options, then review lender rates and repayment terms.'}</p><a class="rk-button rk-button-outline" href="/offers/flexible-financing/">Explore financing<ServiceIcon name="arrow"/></a><p class="rk-landing-small">Financing is subject to lender approval and applicable terms.</p></aside>
    </div></section>
    <ServiceComparison path={page.data.permalink}/>
    {!presentation.hideGallery&&<ServiceGallery family={data.family} title={presentation.galleryTitle}/>}
    {!presentation.hideArticles&&<FeaturedArticles family={data.family} city={data.city} path={page.data.permalink}/>}
    <FAQSection section={data.faq as HeadingData & {items:{question:string;answer:RichNode[]}[]}}/>
    <section id="estimate" class="rk-landing-section rk-home-final-cta rk-landing-estimate"><div class="rk-section-inner rk-quote-strip-inner"><div class="rk-landing-heading"><p class="rk-home-eyebrow">Talk with Roof King</p><h2>{data.quote.title}</h2><RichContent nodes={content.closingBody}/><div class="rk-estimate-contact"><a class="rk-landing-estimate-phone" href={site.phoneHref}><span>Talk with our team</span><strong>{site.phone}</strong></a><a class="rk-button rk-button-primary" href={homeHero.bookingUrl}>Book an inspection<ServiceIcon name="arrow"/></a></div></div><QuoteExperience modalDescription={data.quote.description} showRating={false} inlineHeading={false} client:load/></div></section>
  </article></main><SiteFooter/>
</DocumentLayout>
