---
import type {CollectionEntry} from 'astro:content';
import type {BrandSection,HeadingData,RichNode,ServicePathsData} from '../data/section-types';
import DocumentLayout from './DocumentLayout.astro';
import SiteHeader from '../components/SiteHeader.svelte';
import SiteFooter from '../components/SiteFooter.astro';
import LandingHero from '../components/LandingHero.astro';
import ServicePaths from '../components/ServicePaths.astro';
import CredentialsSection from '../components/CredentialsSection.astro';
import ReviewSection from '../components/ReviewSection.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import RoofMaterialOptions from '../components/RoofMaterialOptions.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BrandStrip from '../components/BrandStrip.astro';
import FAQSection from '../components/FAQSection.astro';
import QuoteExperience from '../components/QuoteExperience.svelte';
import site from '../data/site.json';
import {hero as homeHero} from '../data/home.json';
import '../styles/base.css';
import '../styles/home.css';
import '../styles/home-interactions.css';
import '../styles/services.css';
import '../styles/service-landing.css';
interface Props {page:CollectionEntry<'pages'>;data:typeof import('../data/roofing-landing.json');brands:BrandSection;}
const {page,data,brands}=Astro.props;
const faq=data.faq as HeadingData & {items:{question:string;answer:RichNode[]}[]};
---
<DocumentLayout title={page.data.title} description={page.data.description} canonicalPath={page.data.canonicalPath} image={data.hero.image.src}>
  <SiteHeader client:load/>
  <main id="content" class="rk-site-main rk-service-landing"><article data-service-build="astro-components" data-landing-build="editorial" data-content-source={page.data.source}>
    <LandingHero hero={data.hero}/>
    <div class="rk-landing-trust"><div class="rk-section-inner">{data.credentials.items.map(item=><a href={item.href}><ServiceIcon name="shield"/><span>{item.title}</span><span aria-hidden="true">↗</span></a>)}</div></div>
    <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Roofing'}]}/>
    <ServicePaths section={data.services as ServicePathsData}/>
    <ReviewSection section={data.reviews}/>
    <CredentialsSection section={data.credentials}/>
    <RoofMaterialOptions section={data.materials}/>
    <BrandStrip {brands}/>
    <ProjectShowcase section={data.projects}/>
    <ProcessSteps section={data.process}/>
    <section class="rk-landing-section rk-landing-budget" aria-labelledby="roofing-budget-title"><div class="rk-section-inner rk-landing-split"><div class="rk-landing-heading"><p class="rk-home-eyebrow">{data.budget.eyebrow}</p><h2 id="roofing-budget-title">{data.budget.title}</h2><p>{data.budget.description}</p><ul class="rk-budget-checks">{data.budget.items.map(item=><li><ServiceIcon name="check"/>{item}</li>)}</ul><a class="rk-button rk-button-primary" href="#estimate">Plan your roof estimate <ServiceIcon name="arrow"/></a></div><aside class="rk-budget-financing"><span class="rk-financing-icon"><ServiceIcon name="cost"/></span><p class="rk-home-eyebrow">Make your roofing plan</p><h3>{data.budget.financingTitle}</h3><p>{data.budget.financingCopy}</p><a class="rk-button rk-button-outline" href="/offers/flexible-financing/">Explore financing <ServiceIcon name="arrow"/></a><p class="rk-landing-small">{data.budget.financingNote}</p></aside></div></section>
    <section class="rk-landing-section rk-landing-local" aria-labelledby="roofing-local-title"><div class="rk-section-inner rk-landing-split"><div class="rk-landing-heading"><p class="rk-home-eyebrow">{data.local.eyebrow}</p><h2 id="roofing-local-title">{data.local.title}</h2><p>{data.local.description}</p></div><div class="rk-landing-local-links"><a href={data.local.linkHref}><span class="rk-local-link-icon"><ServiceIcon name="roof"/></span><span>{data.local.linkLabel}<small>Explore roofing services for your home</small></span><ServiceIcon name="arrow"/></a><a href="/contact-us/"><span class="rk-local-link-icon"><ServiceIcon name="building"/></span><span>Contact our Columbus team<small>Get in touch about your roofing project</small></span><ServiceIcon name="arrow"/></a><a href="/service-areas/"><span class="rk-local-link-icon"><ServiceIcon name="roof"/></span><span>Find your service area<small>See the communities we serve</small></span><ServiceIcon name="arrow"/></a></div></div></section>
    <FAQSection section={faq}/>
    <section id="estimate" class="rk-landing-section rk-home-final-cta rk-landing-estimate"><div class="rk-section-inner rk-quote-strip-inner"><div class="rk-landing-heading"><p class="rk-home-eyebrow">{data.quote.eyebrow}</p><h2>{data.quote.title}</h2><p>{data.quote.description}</p><div class="rk-estimate-contact"><a class="rk-landing-estimate-phone" href={site.phoneHref}><span>Talk with our roofing team</span><strong>{site.phone}</strong></a><a class="rk-button rk-button-primary" href={homeHero.bookingUrl}>Book a roof inspection<ServiceIcon name="arrow"/></a></div></div><QuoteExperience modalTitle={data.quote.title} modalDescription={data.quote.description} showRating={false} client:load/></div></section>
  </article></main><SiteFooter/>
</DocumentLayout>
