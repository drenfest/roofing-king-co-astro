---
import type {CollectionEntry} from 'astro:content';
import type {BrandSection,HeadingData,RichNode,ServicePathsData} from '../data/section-types';
import DocumentLayout from './DocumentLayout.astro';
import SiteHeader from '../components/SiteHeader.svelte';
import SiteFooter from '../components/SiteFooter.astro';
import LandingHero from '../components/LandingHero.astro';
import ServicePaths from '../components/ServicePaths.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import HomeImage from '../components/HomeImage.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BrandStrip from '../components/BrandStrip.astro';
import FAQSection from '../components/FAQSection.astro';
import QuoteExperience from '../components/QuoteExperience.svelte';
import site from '../data/site.json';
import '../styles/base.css';
import '../styles/home.css';
import '../styles/home-interactions.css';
import '../styles/services.css';
import '../styles/service-landing.css';
interface Props {page:CollectionEntry<'pages'>;data:typeof import('../data/roofing-landing.json');brands:BrandSection;}
const {page,data,brands}=Astro.props;
const faq=data.faq as HeadingData & {items:{question:string;answer:RichNode[]}[]};
---
<DocumentLayout title={page.data.title} description={page.data.description} canonicalPath={page.data.canonicalPath} image={data.hero.image.src}>
  <SiteHeader client:load/>
  <main id="content" class="rk-site-main rk-service-landing"><article data-service-build="astro-components" data-landing-build="editorial" data-content-source={page.data.source}>
    <LandingHero hero={data.hero}/>
    <div class="rk-landing-trust"><div class="rk-section-inner">{data.credentials.items.map(item=><a href={item.href}><ServiceIcon name="shield"/><span>{item.title}</span><span aria-hidden="true">↗</span></a>)}</div></div>
    <Breadcrumbs items={[{label:'Home',href:'/'},{label:'Roofing'}]}/>
    <ServicePaths section={data.services as ServicePathsData}/>
    <section class="rk-landing-section rk-landing-decision" aria-labelledby="roofing-decision-title"><div class="rk-section-inner rk-landing-split">
      <div class="rk-landing-heading"><p class="rk-home-eyebrow">{data.decision.eyebrow}</p><h2 id="roofing-decision-title">{data.decision.title}</h2>{data.decision.paragraphs.map(p=><p>{p}</p>)}<a class="rk-landing-text-link" href="#estimate">Talk through your options <span aria-hidden="true">↗</span></a></div>
      <aside class="rk-landing-checklist"><h3>{data.decision.checklistTitle}</h3><ul>{data.decision.items.map(item=><li><ServiceIcon name="check"/>{item}</li>)}</ul><p>{data.decision.note}</p></aside>
    </div></section>
    <ProjectShowcase section={data.projects}/>
    <section class="rk-landing-section rk-landing-credentials" aria-labelledby="roofing-credentials-title"><div class="rk-section-inner"><div class="rk-landing-heading"><p class="rk-home-eyebrow">{data.credentials.eyebrow}</p><h2 id="roofing-credentials-title">{data.credentials.title}</h2></div><div class="rk-landing-credential-list">{data.credentials.items.map(item=><article><span class="rk-credential-mark" aria-hidden="true">{item.mark}</span><h3>{item.title}</h3><p>{item.description}</p><a href={item.href}>{item.label} <span aria-hidden="true">↗</span></a></article>)}</div><p class="rk-landing-small">{data.credentials.note}</p><p class="rk-landing-small"><a href="/roofing/gaf/">Explore GAF roofing and warranty options</a> · <a href="/roofing/gaf/master-elite/">About our Master Elite certification</a></p></div></section>
    <section id="roofing-materials" class="rk-landing-section rk-landing-materials" aria-labelledby="roofing-materials-title"><div class="rk-section-inner"><div class="rk-landing-heading"><p class="rk-home-eyebrow">{data.materials.eyebrow}</p><h2 id="roofing-materials-title">{data.materials.title}</h2><p>{data.materials.description}</p></div><div class="rk-landing-material-grid">{data.materials.items.map(item=><article><a class="rk-material-photo" href={item.href} aria-label={item.label}><HomeImage {...item.image} sizes="(max-width:760px) 100vw, 50vw"/></a><h3>{item.title}</h3><p>{item.description}</p><div class="rk-material-links"><a href={item.href}>{item.label} <span aria-hidden="true">→</span></a><a href={item.relatedHref}>{item.relatedLabel} <span aria-hidden="true">↗</span></a></div></article>)}</div></div></section>
    <BrandStrip {brands}/>
    <ProcessSteps section={data.process}/>
    <section class="rk-landing-section rk-landing-budget" aria-labelledby="roofing-budget-title"><div class="rk-section-inner rk-landing-split"><div class="rk-landing-heading"><p class="rk-home-eyebrow">{data.budget.eyebrow}</p><h2 id="roofing-budget-title">{data.budget.title}</h2><p>{data.budget.description}</p><ul class="rk-budget-checks">{data.budget.items.map(item=><li><ServiceIcon name="check"/>{item}</li>)}</ul><a class="rk-landing-text-link" href="#estimate">Plan your estimate <span aria-hidden="true">↗</span></a></div><aside class="rk-budget-financing"><p class="rk-home-eyebrow">Planning your budget</p><h3>{data.budget.financingTitle}</h3><p>{data.budget.financingCopy}</p><a href="/offers/flexible-financing/">Explore financing information <span aria-hidden="true">↗</span></a><p class="rk-landing-small">{data.budget.financingNote}</p></aside></div></section>
    <section class="rk-landing-section rk-landing-review" aria-labelledby="roofing-review-title"><div class="rk-section-inner"><p class="rk-home-eyebrow">{data.reviews.eyebrow}</p><h2 id="roofing-review-title">{data.reviews.title}</h2><figure><blockquote><p>“{data.reviews.quote}”</p></blockquote><figcaption><strong>{data.reviews.author}</strong><a href={data.reviews.sourceUrl}>{data.reviews.sourceLabel} ↗</a></figcaption></figure><a class="rk-landing-text-link" href="/reviews/">Read more homeowner reviews <span aria-hidden="true">→</span></a></div></section>
    <section class="rk-landing-section rk-landing-local" aria-labelledby="roofing-local-title"><div class="rk-section-inner rk-landing-split"><div class="rk-landing-heading"><p class="rk-home-eyebrow">{data.local.eyebrow}</p><h2 id="roofing-local-title">{data.local.title}</h2><p>{data.local.description}</p></div><div class="rk-landing-local-links"><a href={data.local.linkHref}>{data.local.linkLabel}<ServiceIcon name="arrow"/></a><a href="/contact-us/">Contact our Columbus team<ServiceIcon name="arrow"/></a><a href="/service-areas/">View service areas<ServiceIcon name="arrow"/></a></div></div></section>
    <FAQSection section={faq}/>
    <section id="estimate" class="rk-landing-section rk-home-final-cta rk-landing-estimate"><div class="rk-section-inner rk-quote-strip-inner"><div class="rk-landing-heading"><p class="rk-home-eyebrow">{data.quote.eyebrow}</p><h2>{data.quote.title}</h2><p>{data.quote.description}</p><a class="rk-landing-estimate-phone" href={site.phoneHref}>Prefer to talk? <strong>{site.phone}</strong></a><p class="rk-landing-small">Call our team or book an inspection to get started.</p></div><QuoteExperience modalTitle={data.quote.title} modalDescription={data.quote.description} showRating={false} client:load/></div></section>
  </article></main><SiteFooter/>
</DocumentLayout>
