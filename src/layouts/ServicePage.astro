---
import type { CollectionEntry } from 'astro:content';
import type { ServicePageData } from '../data/section-types';
import { trust } from '../data/home.json';
import { placements, replaceHeadings } from '../data/page-structure';
import DocumentLayout from './DocumentLayout.astro';
import SiteHeader from '../components/SiteHeader.svelte';
import SiteFooter from '../components/SiteFooter.astro';
import PageHero from '../components/PageHero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContentSection from '../components/ContentSection.astro';
import MediaContentRow from '../components/MediaContentRow.astro';
import BrandStrip from '../components/BrandStrip.astro';
import CardSection from '../components/CardSection.astro';
import ReviewSection from '../components/ReviewSection.astro';
import ServiceGallery from '../components/ServiceGallery.astro';
import FeaturedArticles from '../components/FeaturedArticles.astro';
import ComparisonSection from '../components/ComparisonSection.astro';
import CoverageSection from '../components/CoverageSection.astro';
import FAQSection from '../components/FAQSection.astro';
import QuoteSection from '../components/QuoteSection.astro';
import ProductGrid from '../components/ProductGrid.astro';
import ServicePaths from '../components/ServicePaths.astro';
import ServiceTopics from '../components/ServiceTopics.astro';
import {serviceOpening,completeServicePaths} from '../data/service-opening';
import '../styles/base.css';
import '../styles/home.css';
import '../styles/home-interactions.css';
import '../styles/services.css';
import '../styles/service-landing.css';
interface Props { page:CollectionEntry<'pages'>; data:ServicePageData; }
const { page, data } = Astro.props;
const placement=placements[page.data.permalink];
const hero={...data.hero,...placement?.hero};
const opening=data.sections.some(s=>s.type==='service-paths')?undefined:serviceOpening(page.data.permalink,data.sections);
const sections=opening?.sections || data.sections;
---
<DocumentLayout title={page.data.title} description={page.data.description} canonicalPath={page.data.canonicalPath} image={data.hero.image}>
  <SiteHeader client:load/>
  <main id="content" class="rk-site-main"><article class:list={['rk-native-service',{'rk-service-landing':data.sections.some(section=>section.type==='service-paths')}]} data-service-build="astro-components" data-content-source={page.data.source}>
    <PageHero {hero}/><TrustStrip {trust}/><Breadcrumbs items={placement?.breadcrumbs || data.breadcrumbs}/>
    {opening && <ServiceTopics section={{...opening.opening,items:opening.opening.items.map(item=>({...item,title:placement?.headings?.[item.title] || item.title,body:replaceHeadings(item.body,placement?.headings)}))}}/>}
    {sections.map(section=>section.type==='content'?<ContentSection section={{...section,body:replaceHeadings(section.body,placement?.headings)}}/>:
      section.type==='media-row'?<MediaContentRow {section}/>:
      section.type==='service-paths'?<ServicePaths section={completeServicePaths(page.data.permalink,section)}/>:
      section.type==='brands'?<BrandStrip brands={section}/>:
      section.type==='cards'?(section.kind==='reviews'?<ReviewSection {section}/>:<CardSection kind={section.kind} section={section}/>):
      section.type==='gallery'?<ServiceGallery family="gaf-catalog"/>:
      section.type==='comparison'?<ComparisonSection comparison={section}/>:
      section.type==='coverage'?<CoverageSection coverage={section}/>:
      section.type==='faq'?<FAQSection {section}/>:
      section.type==='products'?<ProductGrid {section}/>:
      section.type==='quote'?<QuoteSection quote={section}/>:null)}
    <FeaturedArticles family="gaf" path={page.data.permalink}/>
  </article></main><SiteFooter/>
</DocumentLayout>
