    "check": "astro check && svelte-check --tsconfig ./tsconfig.json && node scripts/check-content.mjs",
    "check:routes": "node scripts/check-built-routes.mjs",
    "verify": "node scripts/verify.mjs",
    "import:wordpress": "node scripts/import-wordpress.mjs",
    "check:homepage": "node scripts/check-homepage.mjs",
    "optimize:home": "node scripts/optimize-home-media.mjs",
    "audit:components": "node scripts/audit-component-reuse.mjs",
    "check:services": "node scripts/check-services.mjs",
    "optimize:services": "node scripts/optimize-service-media.mjs",
    "optimize:products": "node scripts/optimize-product-media.mjs",
    "check:products": "node scripts/check-products.mjs",
    "check:service-copy": "node scripts/check-service-pdf.mjs",
    "check:heroes": "node scripts/check-roofing-heroes.mjs",
    "check:service-reviews": "node scripts/check-service-reviews.mjs",
    "check:service-photos": "node scripts/check-service-photo-pairs.mjs",
