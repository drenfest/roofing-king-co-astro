    "check:locations": "node scripts/check-location-hubs.mjs",
    "check:articles": "node scripts/check-featured-articles.mjs",
    "check:html-attributes": "node scripts/check-html-attributes.mjs",
    "check:blog-hubs": "node scripts/check-blog-hubs.mjs",
    "check:blog-urls": "node scripts/check-blog-urls.mjs",
    "check:native-articles": "node scripts/check-native-articles.mjs",
    "check:warranty": "node scripts/check-warranty-page.mjs",
    "check:offers": "node scripts/check-offers-pages.mjs",
    "check:schema": "node scripts/check-structured-data.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:photography": "node scripts/check-client-photography.mjs",
    "check:manufacturer-products": "node scripts/check-manufacturer-products.mjs",
    "check:product-systems": "node scripts/check-product-systems.mjs",
    "check:ply-gem": "node scripts/check-ply-gem-products.mjs",
    "check:comparisons": "node scripts/check-service-comparisons.mjs",
