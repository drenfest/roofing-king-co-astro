# Static Astro review site. No WordPress front controller.
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
<FilesMatch "(^\.|^ai-context\.md$|\.php$)">
  Require all denied
</FilesMatch>
