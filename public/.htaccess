# Static Astro review site. No WordPress front controller.
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  <FilesMatch "^menu-thumbnails-[a-f0-9]{12}\.webp$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<FilesMatch "(^\.|^ai-context\.md$|\.php$)">
  Require all denied
</FilesMatch>
